# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 커밋되지 않습니다)
# GitHub Actions에서는 저장소 Settings > Secrets and variables > Actions에 등록하세요.

# 공공데이터포털 (data.go.kr) 인증키 - 수집기(crawler/)가 읽음. 일반 인증키(Decoding) 값을 넣으세요
DATA_GO_KR_KEY=

# Jev (TypeSafe AI) - 수집기가 규칙 다음에 묻는 두 번째 의견(14~24세 가능 여부, 학교 밖 청소년 가능 여부)
# 없으면 규칙만으로 판단한다. 공모전 레이더와 같은 키를 쓴다
TYPESAFE_API_KEY=

# 일반 LLM - 공고 요약, 로드맵 설명 생성
LLM_API_KEY=
