{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "공통 정의",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$",
      "description": "영문 소문자·숫자·하이픈. 한 번 공개하면 바꾸지 않는다."
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "holland": {
      "type": "string",
      "enum": [
        "R",
        "I",
        "A",
        "S",
        "E",
        "C"
      ]
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://"
    }
  }
}
