---
// Shared page shell for the D22 design language. Pages own their main content.
import "../styles/tokens.css";
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = "지금 내 자리에서 시작하는 진로. 어디서 시작해도 갈 수 있는 길을 노선도로 보여 줘요.", noindex = false } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = `${title} · 지금 내 자리에서`;
const nav = [
  { href: "/fields/cooking", label: "노선도", match: "/fields" },
  { href: "/guide", label: "읽을거리", match: "/guide" },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1b1f2a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Gowun+Dodum&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-top">
      <a class="brand" href="/"><span class="brand-dot" aria-hidden="true"></span>지금 내 자리에서</a>
      <nav aria-label="주요 메뉴">
        {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.match) ? "page" : undefined}>{n.label}</a>)}
      </nav>
    </header>
    <slot />
    <footer class="site-foot">
      <div class="rule-lines" aria-hidden="true"></div>
      <p>어느 노선이 더 좋은 건 아니에요. 정보는 공식 출처로 확인하고, 확인한 날짜를 함께 적어요.</p>
      <p class="quiet">광고 없음 · 학생 정보를 팔지 않아요</p>
    </footer>
  </body>
</html>

<style is:global>
  .site-top {
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: 0 16px; min-height: 52px; background: var(--ink); color: #fff; font-size: 15px;
    position: sticky; top: 0; z-index: 20;
  }
  .site-top a { color: #fff; text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .site-top .brand { font-weight: 700; gap: 8px; }
  .brand-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--paper); border: 3px solid var(--line-1); box-shadow: 0 0 0 2px var(--ink), 0 0 0 4px #fff; }
  .site-top nav { display: flex; gap: 4px; }
  .site-top nav a { padding: 0 10px; opacity: 0.8; }
  .site-top nav a[aria-current="page"], .site-top nav a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 6px; }
  .site-foot { margin-top: 56px; padding: 0 0 40px; text-align: center; font-size: 14px; color: var(--ink-2); }
  .site-foot p { margin: 6px 16px; }
  .site-foot .rule-lines { margin-bottom: 20px; }
  .site-foot .quiet { color: var(--lead); }
  @media (min-width: 900px) { .site-top { padding: 0 40px; } }
</style>
