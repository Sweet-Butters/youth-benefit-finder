---
// 혜택 board (D26): every youth benefit the crawler collected, one row each, soonest deadline first.
// Filters, search and paging run in the browser; without JS the first page is in the HTML.
// View counts are fetched only for the rows on screen (window.ycFillViews from Site.astro).
// 한국장학재단 장학금 stay after they close (D28): they come after every live entry as "지난 모집", under a divider.
// With thousands of entries the list data is its own file (./board.json, lib/payload.ts), fetched on load;
// the page carries only the first rows, which is also what a reader without JS sees.
import Site from "../../layouts/Site.astro";
import ViewCount from "../../components/ViewCount.astro";
import { boardEntries, stateOn, nextExpected, nextLabel, todayKst, daysBetween, shortRange, md, openMonth, KIND, KIND_ORDER, KIND_COLOR, STATUS_LABEL, ALWAYS_SORT, MAJOR_GROUPS, WHO, WHO_ORDER, COND, type BoardEntry } from "../../lib/board";
import { WHO_LETTER, COND_LETTER } from "../../lib/payload";
import { collected } from "../../lib/collected";
import { REGION_LABEL } from "../../lib/content";
import { quiz } from "../../lib/findtalk";
import { countPath, GC_CODE } from "../../lib/stats";
import { url } from "../../lib/url";

const PER = 20;
const today = todayKst();
const entries = boardEntries();
// A kind with nothing on the board today gets no button (and no filter choice).
const states = new Map(entries.map((e) => [e.id, stateOn(e, today)]));
const isLive = (e: BoardEntry) => states.get(e.id)!.live;
const counts = KIND_ORDER.map((k) => ({
  k, label: KIND[k], n: entries.filter((e) => e.kind === k).length, live: entries.filter((e) => e.kind === k && isLive(e)).length,
})).filter((c) => c.n > 0);
const closedN = entries.filter((e) => states.get(e.id)!.status === "closed").length;
const kindList = counts.map((c) => c.label).join("·");
// 공모전 come from listing sites, not agencies: the lead says so, and names the sites on the board today.
const contestSites = [...new Set(entries.filter((e) => e.kind === "contest").map((e) => e.sourceLabel))];
// 전국 first as its own choice, then every 시·도 in the usual order.
const regionOpts = Object.entries(REGION_LABEL);
const helpsBase = url("/helps/");
const viewBase = `${countPath(url("/helps/x")).slice(0, -1)}`;
const updated = collected.updatedAt.slice(0, 10);

// The same row the script draws (row() below), for the first page and for no-JS.
// 상시 has no D-day, only its badge; a deadline today reads "오늘 마감".
// 지난 모집 shows the badge in the D-day box, last round's dates with the year, and when it is expected next.
function view(e: BoardEntry) {
  const st = states.get(e.id)!;
  const closed = st.status === "closed";
  const n = st.date ? daysBetween(today, st.date) : 0;
  const always = st.status === "always";
  const todayEnd = st.status === "open" && n === 0;
  const dd = closed ? "지난 모집" : always ? "상시" : todayEnd ? "오늘 마감" : n === 0 ? "오늘" : `D-${n}`;
  const sub = closed ? "" : always ? "언제든 신청" : todayEnd ? "" : st.status === "open" ? "마감" : st.status === "upcoming" ? "접수 시작" : "활동일";
  const date = closed ? { k: "지난", v: `${st.window!.s.slice(0, 4)}년 ${shortRange(st.window!.s, st.window!.e)}` }
    : st.window ? { k: "신청", v: shortRange(st.window.s, st.window.e) } : always ? { k: "신청", v: "상시" } : { k: "활동", v: st.date ? md(st.date) : "" };
  const nx = closed ? nextExpected(e, today) : null;
  return { e, st, dd, sub, date, next: nx ? `다음 예상 ${nextLabel(nx)}` : "", todayEnd, closed, urgent: st.status === "open" && n <= 7, tags: tagLine(e) };
}
// 누가 · 조건 · 모음 사이트 as one small text line (#1, #2): "고등학생 · 학교 밖 · 소득 기준". The script's tagLine() repeats it.
function tagLine(e: BoardEntry) {
  const who = e.who.includes("all") ? [WHO.all] : e.who.map((k) => WHO[k]);
  const conds = e.conds.filter((k) => k !== "region").map((k) => COND[k]);
  return [...who, ...conds, ...(e.sites.length > 1 ? [`모음 사이트 ${e.sites.length}곳`] : [])].join(" · ");
}
const first = entries.slice(0, PER).map(view);
const SEP = "지난 모집 · 해마다 다시 열리는 장학금";

// 요약 줄 (#4) as of the build day; the script re-counts from the browser's date.
const thisMonth = +today.slice(5, 7);
const sum = {
  open: entries.filter((e) => states.get(e.id)!.status === "open").length,
  soon: entries.filter((e) => { const s = states.get(e.id)!; return s.status === "open" && daysBetween(today, s.date) <= 7; }).length,
  scholar: entries.filter((e) => e.kind === "scholarship" && openMonth(e, today)?.month === thisMonth).length,
  oos: entries.filter((e) => e.who.includes("oos") || e.who.includes("all")).length,
};
// 내 조건 (#6) choices: the find-talk's own answers (index.astro), so its saved answers fill this box.
const AGE_OPTS: [string, string][] = [["14-16", "14~16살"], ["17-19", "17~19살"], ["20-24", "20~24살"]];
const SCHOOL_OPTS: [string, string][] = [["in", "다님"], ["left", "그만둠"], ["done", "졸업"]];
const MY_REGIONS = ["seoul", "gyeonggi", "incheon", ...Object.keys(REGION_LABEL).filter((k) => !["all", "seoul", "gyeonggi", "incheon"].includes(k))];
const NOCOND: [string, string][] = [["income", "소득 기준 없음"], ["grade", "성적 기준 없음"], ["special", "특정 자격 없음"]];

// Settings for the script; the entries themselves come from ./board.json (keys explained in lib/payload.ts).
const data = {
  today, per: PER, base: helpsBase, viewBase, counting: !!GC_CODE, alwaysSort: ALWAYS_SORT, sep: SEP, src: `${helpsBase}board.json`,
  kinds: KIND, order: KIND_ORDER, colors: KIND_COLOR, status: STATUS_LABEL, regions: REGION_LABEL, majors: MAJOR_GROUPS,
  who: Object.fromEntries(WHO_ORDER.map((k) => [k, { l: WHO_LETTER[k], t: WHO[k] }])),
  cond: Object.fromEntries(Object.entries(COND_LETTER).map(([k, l]) => [k, { l, t: COND[k as keyof typeof COND_LETTER] }])),
  ftKey: "ybf:find-talk", ftVersion: quiz?.version ?? 0, myKey: "ybf:my-cond",
  ages: AGE_OPTS.map((o) => o[0]), schools: SCHOOL_OPTS.map((o) => o[0]), myRegions: MY_REGIONS,
};
---
<Site title="혜택" description={`청소년이 받을 수 있는 ${kindList} ${entries.length}개를 마감이 가까운 순서로 모았어요. 기관 공식 자료${contestSites.length ? "와 공모전 모음 사이트" : ""}에서 자동으로 모은 정보예요.`}>
  <main class="hb">
    <header class="head">
      <p class="eyebrow">혜택 · 공식 자동 <ViewCount /></p>
      <h1 class="display">지금 받을 수 있는 혜택</h1>
      <p class="lead">
        {counts.map((c) => c.label).join(", ")} 접수를 마감이 가까운 순서로 모았어요. {contestSites.length ? <>공모전 말고는 모두 <b>공식 자동</b>이에요</> : <>모두 <b>공식 자동</b>이에요</>}. 기관 공식 자료에서 자동으로 모았고, 사람이 아직 확인하지 않았어요. 신청 전에 원문 공고를 꼭 확인하세요.
        {contestSites.length > 0 && <> 공모전은 모음 사이트({contestSites.join("·")})에 올라온 이름·주최·기간·대상만 옮기고 원문으로 이어 드려요.</>}
      </p>
      <p class="asof">{updated && `${updated.replaceAll("-", ".")} 모음 · `}전체 {entries.length}개 · <span class="gone">마감 지난 혜택은 자동으로 사라져요</span>{closedN > 0 && <> · <span class="gone">장학금은 해마다 다시 열려서 ‘지난 모집’으로 남겨요</span></>}</p>
    </header>

    <div class="sumstrip" role="group" aria-label="오늘 한눈에 · 누르면 그대로 걸러요">
      <button type="button" data-sum="open"><span>접수 중</span> <b id="sum-open">{sum.open}</b></button>
      <button type="button" data-sum="soon"><span>7일 안에 마감</span> <b id="sum-soon">{sum.soon}</b></button>
      <button type="button" data-sum="scholar"><span>이번 달 여는 장학금</span> <b id="sum-scholar">{sum.scholar}</b></button>
      <button type="button" data-sum="oos"><span>학교 밖도 가능</span> <b id="sum-oos">{sum.oos}</b></button>
    </div>

    <div class:list={["kstrip", { many: counts.length + 1 > 5 }]} role="group" aria-label="분류별 개수와 거르기" style={`--n:${counts.length + 1}`}>
      <button type="button" class="kc" data-kind="" aria-pressed="true" style="--c:var(--ink)">
        <b>{entries.length}</b><span>전체</span>
      </button>
      {counts.map((c) => (
        <button type="button" class="kc" data-kind={c.k} aria-pressed="false" style={`--c:${KIND_COLOR[c.k]}`}>
          <b>{c.n}</b><span>{c.label}</span>{c.live < c.n && <small class="kc-live">지금 신청 가능 <em>{c.live}</em></small>}
        </button>
      ))}
    </div>

    <section class="mine" aria-labelledby="mine-h">
      <h2 id="mine-h">내 조건</h2>
      <div class="mine-f">
        <label class="f">
          <span>나이</span>
          <select id="m-age"><option value="">안 고름</option>{AGE_OPTS.map(([k, v]) => <option value={k}>{v}</option>)}</select>
        </label>
        <label class="f">
          <span>학교</span>
          <select id="m-school"><option value="">안 고름</option>{SCHOOL_OPTS.map(([k, v]) => <option value={k}>{v}</option>)}</select>
        </label>
        <label class="f">
          <span>지역</span>
          <select id="m-region"><option value="">안 고름</option>{MY_REGIONS.map((k) => <option value={k}>{REGION_LABEL[k]}</option>)}</select>
        </label>
      </div>
      <p class="mine-note">이 기기에만 저장돼요. 어디로도 보내지 않아요.</p>
    </section>

    <div class="chips" role="group" aria-labelledby="who-h">
      <span class="chips-h" id="who-h">누가</span>
      <div class="chip-row">
        {WHO_ORDER.map((k) => <button type="button" class="chip" data-who={k} aria-pressed="false">{WHO[k]}</button>)}
      </div>
    </div>
    <div class="chips" role="group" aria-labelledby="cond-h">
      <span class="chips-h" id="cond-h">조건</span>
      <div class="chip-row">
        {NOCOND.map(([k, v]) => <button type="button" class="chip" data-nocond={k} aria-pressed="false">{v}</button>)}
      </div>
      <small class="chips-note">누가: 고른 대상이나 ‘누구나’인 것만 보여요. 조건: 고르면 그 기준이 있는 혜택을 숨겨요.</small>
    </div>

    <form class="filters" id="filters" role="search" aria-label="혜택 거르기" onsubmit="return false">
      <label class="f">
        <span>지역</span>
        <select id="f-region">
          <option value="">모든 지역</option>
          {regionOpts.map(([k, v]) => <option value={k}>{k === "all" ? "전국 대상만" : `${v} + 전국`}</option>)}
        </select>
      </label>
      <label class="f">
        <span>상태</span>
        <select id="f-status">
          <option value="">모든 상태</option>
          <option value="open">접수 중</option>
          <option value="upcoming">곧 열림</option>
          <option value="check">일정 확인</option>
          {entries.some((e) => e.always) && <option value="always">상시</option>}
          {closedN > 0 && <option value="closed">지난 모집 (다시 열릴 수 있어요)</option>}
        </select>
      </label>
      <label class="f">
        <span>학과 계열</span>
        <select id="f-major">
          <option value="">전체</option>
          <option value="any">누구나</option>
          {MAJOR_GROUPS.map((g) => <option value={g}>{g}</option>)}
        </select>
      </label>
      <label class="f">
        <span>여는 달</span>
        <select id="f-month">
          <option value="">모든 달</option>
          {Array.from({ length: 12 }, (_, i) => <option value={String(i + 1)}>{i + 1}월</option>)}
        </select>
      </label>
      <label class="f q">
        <span>찾기</span>
        <input type="search" id="f-q" placeholder="이름, 기관, 대상" autocomplete="off" enterkeyhint="search" />
      </label>
      <button type="button" class="reset" id="f-reset" hidden>조건 지우기</button>
    </form>

    <section class="results" aria-labelledby="res-h">
      <div class="sortbar">
        <label class="f sort">
          <span>순서</span>
          <select id="f-sort">
            <option value="fit">나에게 맞는 순</option>
            <option value="due" selected>마감 가까운 순</option>
            <option value="new">새로 올라온 순</option>
          </select>
        </label>
        <p class="sort-note" id="sort-note">마감이 가까운 순서예요. 체험은 다음 활동일로 세고, 상시는 날짜가 있는 것 뒤에 둬요.</p>
      </div>
      <p class="res-h" id="res-h" tabindex="-1"><b id="res-n">{entries.length}개</b> <span id="res-note">마감이 가까운 순서</span></p>
      <p class="nojs">자바스크립트가 꺼져 있어서 마감이 가까운 {Math.min(PER, entries.length)}개만 보여요. 거르기와 다음 쪽은 자바스크립트를 켜면 쓸 수 있어요.</p>
      <div class="thead" aria-hidden="true"><span>분류</span><span>혜택</span><span>지역</span><span>신청 · 활동일</span><span>남은 날</span><span>조회</span></div>
      <ol class="rows" id="rows" data-views-manual>
        {first.map(({ e, st, dd, sub, date, next, urgent, todayEnd, closed, tags }, i) => (
          <>{closed && (i === 0 || !first[i - 1].closed) && <li class="sep">{SEP}</li>}
          <li><a class="hr" href={`${helpsBase}${e.id}/`} style={`--c:${KIND_COLOR[e.kind]}`}>
            <span class="h-kind"><i aria-hidden="true"></i>{e.kindLabel}</span>
            <span class="h-main"><span class="h-title">{e.title}</span><span class="h-prov">{e.provider}</span>{tags && <span class="h-tags">{e.who.length > 0 && <><small>대상</small> </>}{tags}</span>}</span>
            <span class="h-reg">{e.regionLabel}</span>
            <span class="h-date"><small>{date.k}</small> {date.v}{next && <span class="h-next">{next}</span>}</span>
            <span class:list={["h-dd", `s-${st.status}`, { urgent, today: todayEnd }]}><b>{dd}</b>{sub && <small>{sub}</small>}</span>
            <span class="h-views">{GC_CODE && <span class="views" data-views={`${viewBase}${e.id}`} data-label="조회" hidden></span>}</span>
          </a></li></>
        ))}
      </ol>
      <p class="empty" id="empty" hidden>조건에 맞는 혜택이 없어요. 조건을 줄여 보세요.</p>
      <nav class="pager" id="pager" aria-label="쪽 넘기기" hidden></nav>
      <p class="foot">‘조회’는 50회가 넘은 것만 보여요. 순서는 광고와 상관없이 마감일(체험은 다음 활동일) 순서예요.{closedN > 0 && " 지난 모집 장학금은 그 뒤에, 다음 모집 예상일이 가까운 순서로 둬요. 예상일은 지난 일정이 해마다 되풀이된다고 보고 셌어요."} ‘학과 계열’과 ‘여는 달’은 장학금 공고의 학과 조건과 신청 시작 달(지난 모집은 다음 예상 달)로 걸러요. ‘누가’와 ‘조건’은 공고의 대상 설명을 자동으로 읽은 거라 틀릴 수 있어요. 신청 전에 원문에서 확인하세요.</p>
    </section>
  </main>

  <script type="application/json" id="board-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>
  <script is:inline>
    (async () => {
      const D = JSON.parse(document.getElementById("board-data").textContent);
      // The rows in the HTML stay until the list arrives; if it never does, the page stays as it is without JS.
      try { D.items = await (await fetch(D.src)).json(); } catch { return; }
      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
      const pad = (n) => String(n).padStart(2, "0");
      const now = new Date();
      const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      const days = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 864e5);
      const md = (d) => `${+d.slice(5, 7)}월 ${+d.slice(8, 10)}일`;
      const range = (s, e) => (s === e ? md(s) : `${md(s)}~${md(e)}`);

      const regionLabel = (r) => (r.includes("all") ? "전국" : r.length ? r.map((k) => D.regions[k] || k).join(" · ") : "지역 제한");
      // 다음 예상: the last round's start rolled forward by whole years to today or later (nextExpected in lib/board.ts).
      // 지난 모집 sort after every live entry by that date, soonest first (closedSortKey).
      const nextDate = (v) => { let y = +v[0].slice(0, 4); const rest = v[0].slice(4); while (`${y}${rest}` < today) y++; return `${y}${rest}`; };
      const closedKey = (v) => `9999-${nextDate(v)}`;
      // Re-judge every entry against today's date; one with nothing left ahead is dropped,
      // except a recurring 장학금 (c), which becomes 지난 모집 with its last round.
      const items = D.items.map((x) => {
        const all = x.w || [], r = x.r || ["all"];
        const w = all.filter((v) => v[1] >= today);
        const s = (x.s || []).filter((d) => d >= today);
        let st, date, sortKey, win;
        if (w.length) {
          const open = w.find((v) => v[0] <= today);
          win = open || w[0];
          st = open ? "open" : "upcoming"; date = open ? win[1] : win[0]; sortKey = win[1];
        } else if (s.length) { st = "check"; date = s[0]; sortKey = s[0]; }
        else if (x.a) { st = "always"; date = ""; sortKey = D.alwaysSort; }
        else if (x.c && all.length) { win = all.reduce((a, v) => (v[0] > a[0] ? v : a)); st = "closed"; date = ""; sortKey = closedKey(win); }
        else return null;
        // The month it opens in: this round's start, or 다음 예상 for 지난 모집 (openMonth in lib/board.ts).
        const nx = st === "closed" ? nextDate(win) : "";
        const mon = nx ? +nx.slice(5, 7) : win ? +win[0].slice(5, 7) : 0;
        return { ...x, k: D.order[x.k], r, rl: regionLabel(r), q: `${x.t} ${x.p} ${x.q || ""}`.toLowerCase(), st, date, sortKey, win, nx, mon, f: x.f || "", n: x.n || "" };
      }).filter(Boolean).sort((a, b) => (a.sortKey < b.sortKey ? -1 : a.sortKey > b.sortKey ? 1 : a.t.localeCompare(b.t, "ko")));

      // ---------- 누가 · 조건 (#1): letters from lib/payload.ts (WHO_LETTER, COND_LETTER) ----------
      const WHO_KEYS = Object.keys(D.who), COND_KEYS = Object.keys(D.cond);
      const WL = Object.fromEntries(WHO_KEYS.map((k) => [D.who[k].l, D.who[k].t]));
      const CL = Object.fromEntries(COND_KEYS.map((k) => [D.cond[k].l, D.cond[k].t]));
      function tagLine(x) {
        const f = x.f || "", n = x.n || "";
        const who = f.includes(D.who.all.l) ? [D.who.all.t] : [...f].map((l) => WL[l]).filter(Boolean);
        return [...who, ...[...n].map((l) => CL[l]).filter(Boolean), ...(x.x > 1 ? [`모음 사이트 ${x.x}곳`] : [])].join(" · ");
      }
      // An entry fits the 누가 choice when it names any chosen group, or is for 누구나.
      const whoMatch = (x, keys) => x.f.includes(D.who.all.l) || keys.some((k) => x.f.includes(D.who[k].l));

      // ---------- 내 조건 (#6): only in this browser (localStorage), never sent ----------
      // Prefilled from the find-talk's answers on the home page (age, school, region are its first three).
      // Our own copy remembers which find-talk answers it last saw, so a newer talk wins over an older edit here.
      const store = {
        get(k) { try { return JSON.parse(localStorage.getItem(k) || "null"); } catch { return null; } },
        set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
      };
      const clean = (a) => ({
        age: D.ages.includes(a?.age) ? a.age : "", school: D.schools.includes(a?.school) ? a.school : "", region: D.myRegions.includes(a?.region) ? a.region : "",
      });
      function fromTalk() {
        const x = store.get(D.ftKey);
        if (!x || x.v !== D.ftVersion || !Array.isArray(x.a)) return null;
        const c = clean({ age: x.a[0], school: x.a[1], region: x.a[2] });
        return c.age || c.school || c.region ? c : null;
      }
      const same = (a, b) => JSON.stringify(a || null) === JSON.stringify(b || null);
      function loadMine() {
        const talk = fromTalk(), own = store.get(D.myKey);
        if (talk && (!own || !same(own.ft, talk))) return talk;
        return clean(own);
      }
      function saveMine() {
        // Keep the find-talk's first three answers in step, so the home page shows the same 내 조건.
        const x = store.get(D.ftKey);
        if (x && x.v === D.ftVersion && Array.isArray(x.a) && x.a.length > 3) {
          x.a[0] = M.age || "skip"; x.a[1] = M.school || "skip"; x.a[2] = M.region || "skip";
          store.set(D.ftKey, x);
        }
        store.set(D.myKey, { ...M, ft: fromTalk() });
      }
      let M = loadMine();
      const mineSet = () => !!(M.age || M.school || M.region);
      // The school stages I could be at: generous, so only a clear mismatch hides anything.
      function myStages() {
        const byAge = { "14-16": ["middle", "high"], "17-19": ["high", "univ"], "20-24": ["univ", "young"] };
        const bySchool = {
          in: { "14-16": ["middle", "high"], "17-19": ["high", "univ"], "20-24": ["univ", "young"], "": ["middle", "high", "univ"] },
          left: { "14-16": ["oos"], "17-19": ["oos", "young"], "20-24": ["oos", "young"], "": ["oos", "young"] },
          done: { "14-16": ["oos", "high"], "17-19": ["univ", "young"], "20-24": ["univ", "young"], "": ["univ", "young"] },
        };
        const ks = M.school ? bySchool[M.school][M.age] : M.age ? [...byAge[M.age], "oos"] : [];
        return ks.map((k) => D.who[k].l);
      }
      // Hidden under 나에게 맞는 순: another region only, or 누가 names only groups I am not in.
      function fitHidden(x, stages) {
        if (M.region && x.r.length && !x.r.includes("all") && !x.r.includes(M.region)) return true;
        if (stages.length && x.f && !x.f.includes(D.who.all.l) && ![...x.f].some((l) => stages.includes(l))) return true;
        return false;
      }
      // Names my stage (not only 누구나) and names my region (not 전국): each counts one.
      const fitScore = (x, stages) => (stages.some((l) => x.f.includes(l)) ? 1 : 0) + (M.region && x.r.includes(M.region) ? 1 : 0);
      items.forEach((x, i) => { x.ix = i; x.tags = tagLine(x); });

      const qs = new URLSearchParams(location.search);
      const list = (v, ok) => (v || "").split(",").filter((k, i, a) => ok.includes(k) && a.indexOf(k) === i);
      const S = {
        kind: qs.get("kind") || "", region: qs.get("region") || "", status: qs.get("status") || "", q: qs.get("q") || "",
        major: qs.get("major") || "", month: qs.get("month") || "", page: Math.max(1, +qs.get("page") || 1),
        who: list(qs.get("who"), WHO_KEYS), nocond: list(qs.get("nocond"), COND_KEYS), due: qs.get("due") || "", sort: qs.get("sort") || "",
      };
      if (!D.kinds[S.kind] || !document.querySelector(`.kc[data-kind="${S.kind}"]`)) S.kind = "";
      if (S.region && !D.regions[S.region]) S.region = "";
      if (!D.status[S.status] || !document.querySelector(`#f-status option[value="${S.status}"]`)) S.status = "";
      // major: "any" (누구나), or one or more 학과 계열 joined by commas (a field page links its own groups, e.g. 사회,교육).
      if (S.major !== "any") S.major = S.major.split(",").filter((g) => D.majors.includes(g)).join(",");
      if (!/^([1-9]|1[0-2])$/.test(S.month)) S.month = "";
      // due=N: 접수 중 and closing within N days (the 요약 줄's "7일 안에 마감").
      if (!/^([1-9]|[12]\d|30)$/.test(S.due)) S.due = "";
      if (!["fit", "due", "new"].includes(S.sort)) S.sort = "";
      // 나에게 맞는 순 is the default once 내 조건 is set; 마감 가까운 순 otherwise.
      const sortOf = () => (S.sort === "fit" && !mineSet() ? "due" : S.sort || (mineSet() ? "fit" : "due"));

      const kbtns = [...document.querySelectorAll(".kc")];
      const wbtns = [...document.querySelectorAll("[data-who]")], cbtns = [...document.querySelectorAll("[data-nocond]")];
      const fRegion = $("f-region"), fStatus = $("f-status"), fMajor = $("f-major"), fMonth = $("f-month"), fQ = $("f-q"), reset = $("f-reset");
      const fSort = $("f-sort"), mAge = $("m-age"), mSchool = $("m-school"), mRegion = $("m-region");
      // A combined group from a field page gets its own choice so the select can show it.
      if (S.major.includes(",")) fMajor.add(new Option(S.major.split(",").join("·"), S.major));
      fRegion.value = S.region; fStatus.value = S.status; fMajor.value = S.major; fMonth.value = S.month; fQ.value = S.q;
      const fillMine = () => { mAge.value = M.age; mSchool.value = M.school; mRegion.value = M.region; };
      fillMine();
      const majorLabel = (v) => (v === "any" ? "학과 누구나" : `${v.split(",").join("·")} 계열`);
      const SORT_NOTE = {
        fit: "내 나이·학교·지역에 맞지 않는 대상과 지역은 빼고, 내 학교급이나 지역을 콕 집은 것을 먼저, 그다음 마감이 가까운 순서예요.",
        due: "마감이 가까운 순서예요. 체험은 다음 활동일로 세고, 상시는 날짜가 있는 것 뒤에 둬요.",
        new: "이 사이트에 처음 올라온 날이 최근인 순서예요. 같은 날이면 마감이 가까운 것부터예요.",
      };

      function matches(x, skipKind, ctx) {
        if (!skipKind && S.kind && x.k !== S.kind) return false;
        if (S.region === "all" ? !x.r.includes("all") : S.region && !x.r.includes(S.region) && !x.r.includes("all")) return false;
        if (S.status && x.st !== S.status) return false;
        // 학과 계열 is a 장학금 condition: with it set, only 장학금 pass ("?" 특정 학과 matches no group).
        if (S.major) {
          if (!x.m) return false;
          if (S.major === "any" ? x.m !== "*" : !(Array.isArray(x.m) && x.m.some((g) => S.major.split(",").includes(g)))) return false;
        }
        if (S.month && x.mon !== +S.month) return false;
        if (S.due && !(x.st === "open" && days(today, x.date) <= +S.due)) return false;
        if (S.who.length && !whoMatch(x, S.who)) return false;
        if (S.nocond.length && S.nocond.some((k) => x.n.includes(D.cond[k].l))) return false;
        if (ctx.fit && fitHidden(x, ctx.stages)) return false;
        if (S.q) { const words = S.q.toLowerCase().split(/\s+/).filter(Boolean); if (!words.every((w) => x.q.includes(w))) return false; }
        return true;
      }

      // Same row as view() in the frontmatter: 상시 has no D-day, a deadline today reads "오늘 마감".
      function row(x) {
        const always = x.st === "always", closed = x.st === "closed";
        const n = always || closed ? 0 : days(today, x.date);
        const todayEnd = x.st === "open" && n === 0;
        const dd = closed ? "지난 모집" : always ? "상시" : todayEnd ? "오늘 마감" : n === 0 ? "오늘" : `D-${n}`;
        const sub = closed ? "" : always ? "언제든 신청" : todayEnd ? "" : x.st === "open" ? "마감" : x.st === "upcoming" ? "접수 시작" : "활동일";
        const date = closed ? ["지난", `${x.win[0].slice(0, 4)}년 ${range(x.win[0], x.win[1])}`]
          : x.win ? ["신청", range(x.win[0], x.win[1])] : always ? ["신청", "상시"] : ["활동", md(x.date)];
        const cls = (x.st === "open" && n <= 7 ? " urgent" : "") + (todayEnd ? " today" : "");
        return `<li><a class="hr" href="${D.base}${esc(x.i)}/" style="--c:${D.colors[x.k]}">` +
          `<span class="h-kind"><i aria-hidden="true"></i>${esc(D.kinds[x.k])}</span>` +
          `<span class="h-main"><span class="h-title">${esc(x.t)}</span><span class="h-prov">${esc(x.p)}</span>${x.tags ? `<span class="h-tags">${x.f ? "<small>대상</small> " : ""}${esc(x.tags)}</span>` : ""}</span>` +
          `<span class="h-reg">${esc(x.rl)}</span>` +
          `<span class="h-date"><small>${date[0]}</small> ${esc(date[1])}${closed ? `<span class="h-next">다음 예상 ${+x.nx.slice(0, 4)}년 ${+x.nx.slice(5, 7)}월쯤</span>` : ""}</span>` +
          `<span class="h-dd s-${x.st}${cls}"><b>${dd}</b>${sub ? `<small>${sub}</small>` : ""}</span>` +
          `<span class="h-views">${D.counting ? `<span class="views" data-views="${D.viewBase}${esc(x.i)}" data-label="조회" hidden></span>` : ""}</span></a></li>`;
      }

      function pages(cur, last) {
        // 1 … cur-1 cur cur+1 … last
        const out = [];
        for (let p = 1; p <= last; p++) if (p === 1 || p === last || Math.abs(p - cur) <= 1 || (cur <= 3 && p <= 4) || (cur >= last - 2 && p >= last - 3)) out.push(p);
        return out.flatMap((p, i) => (i && p - out[i - 1] > 1 ? ["…", p] : [p]));
      }

      function sync() {
        const p = new URLSearchParams();
        if (S.kind) p.set("kind", S.kind);
        if (S.who.length) p.set("who", S.who.join(","));
        if (S.nocond.length) p.set("nocond", S.nocond.join(","));
        if (S.region) p.set("region", S.region);
        if (S.status) p.set("status", S.status);
        if (S.due) p.set("due", S.due);
        if (S.major) p.set("major", S.major);
        if (S.month) p.set("month", S.month);
        if (S.q) p.set("q", S.q);
        if (S.sort) p.set("sort", S.sort);
        if (S.page > 1) p.set("page", S.page);
        const qs = p.toString().replace(/%2C/g, ",");
        history.replaceState(null, "", location.pathname + (qs ? `?${qs}` : ""));
      }

      // 요약 줄 (#4), counted from today's date over what the list could show (내 조건 applies under 나에게 맞는 순).
      const monthNow = now.getMonth() + 1;
      function summary(ctx) {
        const pool = ctx.fit ? items.filter((x) => !fitHidden(x, ctx.stages)) : items;
        $("sum-open").textContent = pool.filter((x) => x.st === "open").length;
        $("sum-soon").textContent = pool.filter((x) => x.st === "open" && days(today, x.date) <= 7).length;
        $("sum-scholar").textContent = pool.filter((x) => x.k === "scholarship" && x.mon === monthNow).length;
        $("sum-oos").textContent = pool.filter((x) => whoMatch(x, ["oos"])).length;
      }

      function render(focus) {
        const sort = sortOf();
        const ctx = { fit: sort === "fit", stages: myStages() };
        const list = items.filter((x) => matches(x, false, ctx));
        // 지난 모집 stay last in every order, under their divider.
        const tail = (x) => (x.st === "closed" ? 1 : 0);
        if (sort === "fit") list.sort((a, b) => tail(a) - tail(b) || fitScore(b, ctx.stages) - fitScore(a, ctx.stages) || a.ix - b.ix);
        else if (sort === "new") list.sort((a, b) => tail(a) - tail(b) || (a.d || 0) - (b.d || 0) || a.ix - b.ix);
        const last = Math.max(1, Math.ceil(list.length / D.per));
        if (S.page > last) S.page = last;
        const shown = list.slice((S.page - 1) * D.per, S.page * D.per);
        const rows = $("rows");
        // The divider goes above the first 지난 모집 on the page.
        rows.innerHTML = shown.map((x, i) => (x.st === "closed" && (i === 0 || shown[i - 1].st !== "closed") ? `<li class="sep">${esc(D.sep)}</li>` : "") + row(x)).join("");
        $("empty").hidden = list.length > 0;
        $("res-n").textContent = `${list.length}개`;
        const bits = [
          S.kind && D.kinds[S.kind], S.who.length && `누가: ${S.who.map((k) => D.who[k].t).join("·")}`,
          S.nocond.length && `${S.nocond.map((k) => D.cond[k].t.replace(/ 기준$/, "")).join("·")} 기준 없음`.replace("특정 자격 기준", "특정 자격"),
          S.region && (S.region === "all" ? "전국 대상만" : `${D.regions[S.region]} + 전국`), S.status && D.status[S.status], S.due && `${S.due}일 안에 마감`,
          S.major && majorLabel(S.major), S.month && `${S.month}월에 여는 것`, S.q && `‘${S.q}’`,
        ].filter(Boolean);
        const order = sort === "fit" ? "나에게 맞는 순서" : sort === "new" ? "새로 올라온 순서" : S.status === "closed" ? "다음 모집 예상일이 가까운 순서" : "마감이 가까운 순서";
        $("res-note").textContent = (bits.length ? bits.join(" · ") + " · " : "") + order + (last > 1 ? ` · ${S.page}/${last}쪽` : "");
        fSort.value = sort;
        fSort.options[0].disabled = !mineSet();
        fSort.options[0].textContent = mineSet() ? "나에게 맞는 순" : "나에게 맞는 순 (내 조건을 고르면)";
        $("sort-note").textContent = SORT_NOTE[sort];
        reset.hidden = !(S.kind || S.region || S.status || S.major || S.month || S.q || S.who.length || S.nocond.length || S.due || S.sort || mineSet());
        wbtns.forEach((b) => b.setAttribute("aria-pressed", String(S.who.includes(b.dataset.who))));
        cbtns.forEach((b) => b.setAttribute("aria-pressed", String(S.nocond.includes(b.dataset.nocond))));
        kbtns.forEach((b) => {
          b.setAttribute("aria-pressed", String(b.dataset.kind === S.kind));
          const mine = items.filter((x) => (!b.dataset.kind || x.k === b.dataset.kind) && matches(x, true, ctx));
          b.querySelector("b").textContent = mine.length;
          const live = b.querySelector(".kc-live em");
          if (live) live.textContent = mine.filter((x) => x.st !== "closed").length;
        });
        summary(ctx);
        const pager = $("pager");
        pager.hidden = last <= 1;
        pager.innerHTML = last <= 1 ? "" :
          `<button type="button" data-page="${S.page - 1}"${S.page === 1 ? " disabled" : ""}>← 이전</button><span class="nums">` +
          pages(S.page, last).map((p) => (p === "…" ? `<span class="gap">…</span>` : `<button type="button" data-page="${p}"${p === S.page ? ' aria-current="page"' : ""} aria-label="${p}쪽">${p}</button>`)).join("") +
          `</span><button type="button" data-page="${S.page + 1}"${S.page === last ? " disabled" : ""}>다음 →</button>`;
        sync();
        if (window.ycFillViews) window.ycFillViews(rows);
        if (focus) { $("res-h").scrollIntoView({ block: "start" }); $("res-h").focus({ preventScroll: true }); }
      }

      const clearFilters = () => {
        S.kind = S.region = S.status = S.major = S.month = S.q = S.due = ""; S.who = []; S.nocond = []; S.page = 1;
        fRegion.value = fStatus.value = fMajor.value = fMonth.value = fQ.value = "";
      };
      kbtns.forEach((b) => b.addEventListener("click", () => { S.kind = b.dataset.kind; S.page = 1; render(); }));
      wbtns.forEach((b) => b.addEventListener("click", () => {
        const k = b.dataset.who;
        S.who = S.who.includes(k) ? S.who.filter((v) => v !== k) : WHO_KEYS.filter((v) => v === k || S.who.includes(v));
        S.page = 1; render();
      }));
      cbtns.forEach((b) => b.addEventListener("click", () => {
        const k = b.dataset.nocond;
        S.nocond = S.nocond.includes(k) ? S.nocond.filter((v) => v !== k) : COND_KEYS.filter((v) => v === k || S.nocond.includes(v));
        S.page = 1; render();
      }));
      // Each 요약 줄 number is a filter on its own: the others are cleared so the list shows that number.
      document.querySelectorAll("[data-sum]").forEach((b) => b.addEventListener("click", () => {
        clearFilters();
        const k = b.dataset.sum;
        if (k === "open") S.status = "open";
        else if (k === "soon") { S.status = "open"; S.due = "7"; }
        else if (k === "scholar") { S.kind = "scholarship"; S.month = String(monthNow); }
        else if (k === "oos") S.who = ["oos"];
        fStatus.value = S.status; fMonth.value = S.month;
        render(true);
      }));
      fRegion.addEventListener("change", () => { S.region = fRegion.value; S.page = 1; render(); });
      fStatus.addEventListener("change", () => { S.status = fStatus.value; S.due = ""; S.page = 1; render(); });
      fMajor.addEventListener("change", () => { S.major = fMajor.value; S.page = 1; render(); });
      fMonth.addEventListener("change", () => { S.month = fMonth.value; S.page = 1; render(); });
      fSort.addEventListener("change", () => { S.sort = fSort.value === (mineSet() ? "fit" : "due") ? "" : fSort.value; S.page = 1; render(); });
      [mAge, mSchool, mRegion].forEach((el) => el.addEventListener("change", () => {
        M = { age: mAge.value, school: mSchool.value, region: mRegion.value };
        saveMine(); S.page = 1; render();
      }));
      let t;
      fQ.addEventListener("input", () => { clearTimeout(t); t = setTimeout(() => { S.q = fQ.value.trim(); S.page = 1; render(); }, 180); });
      // 조건 지우기: every filter, the order and 내 조건 (kept cleared here even while the find-talk still has its answers).
      reset.addEventListener("click", () => {
        clearFilters(); S.sort = "";
        M = { age: "", school: "", region: "" }; fillMine();
        store.set(D.myKey, { ...M, ft: fromTalk() });
        render();
      });
      $("pager").addEventListener("click", (ev) => {
        const b = ev.target.closest("[data-page]");
        if (!b || b.disabled) return;
        S.page = +b.dataset.page; render(true);
      });
      render();
    })();
  </script>
</Site>

<style is:global>
  .hb { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .hb .head { padding: 28px 0 4px; }
  .hb .eyebrow { margin: 0 0 4px; font-size: 15px; font-weight: 600; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .hb h1 { margin: 0; font-size: clamp(34px, 9vw, 56px); line-height: 1.1; }
  .hb .lead { margin: 14px 0 0; max-width: 40em; line-height: 1.7; }
  .hb .lead b { background: linear-gradient(transparent 55%, var(--mark) 55%); font-weight: 700; }
  .hb .asof { margin: 8px 0 0; font-size: 14px; color: var(--ink-2); }
  .hb .asof .gone { white-space: nowrap; }
  .hb .views { font-size: 13px; color: var(--ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* count strip, doubling as the kind filter */
  .kstrip { display: grid; grid-template-columns: repeat(var(--cols, var(--n, 5)), minmax(0, 1fr)); margin-top: 22px; border-top: 3px solid var(--ink); border-bottom: 1.5px solid var(--ink); }
  /* more than five cells (with 공모전): two rows of four on a phone, so each count keeps its width */
  @media (max-width: 599px) { .kstrip.many { --cols: 4; row-gap: 7px; } .kstrip.many .kc:nth-child(4n + 1) { border-left: 0; padding-left: 2px; } }
  .kc {
    display: flex; flex-direction: column; align-items: flex-start; gap: 0; padding: 10px 4px 10px 8px; min-height: 64px; min-width: 0;
    border: 0; border-left: 1px solid var(--rule); background: none; text-align: left; cursor: pointer; position: relative;
  }
  .kc:first-child { border-left: 0; padding-left: 2px; }
  .kc::before { content: ""; position: absolute; left: 0; right: 0; top: -3px; height: 3px; background: var(--c); }
  /* sized by the number of cells (--n), so a 3-digit count still fits one line on a phone */
  .kc b { font: 400 clamp(20px, calc(34vw / var(--cols, var(--n, 5))), 36px)/1.1 var(--display); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kc span { font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .kc .kc-live { font-size: 12px; font-weight: 600; color: var(--ink-2); line-height: 1.3; }
  .kc .kc-live em { font-style: normal; color: var(--ink); font-variant-numeric: tabular-nums; }
  .kc[aria-pressed="true"] { background: color-mix(in srgb, var(--c) 12%, transparent); }
  .kc[aria-pressed="true"]::before { height: 7px; top: -5px; }
  .kc[aria-pressed="true"] span { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; }
  .kc:hover span { color: var(--ink); }
  html:not(.js) .kc { pointer-events: none; }

  .filters { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 12px; margin-top: 16px; align-items: end; }
  html:not(.js) .filters { display: none; }
  .f { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
