---
// One 공식 자동 benefit (D26): what it is, who can apply, when, and the way to the official notice.
// The info table follows dreamspon.com's order and keeps only the rows the source has.
import Site from "../../layouts/Site.astro";
import ViewCount from "../../components/ViewCount.astro";
import { boardEntries, stateOn, similarTo, todayKst, daysBetween, rangeLabel, ymd, md, STATUS_LABEL, KIND_COLOR, type BoardEntry } from "../../lib/board";
import { fields, steps } from "../../lib/content";
import { url } from "../../lib/url";

export function getStaticPaths() {
  const all = boardEntries();
  return all.map((e) => ({ params: { id: e.id }, props: { e } }));
}
const { e } = Astro.props as { e: BoardEntry };
const today = todayKst();
const st = stateOn(e, today);
const n = st.date ? daysBetween(today, st.date) : 0;
const always = st.status === "always";
const dd = always ? "상시" : n === 0 ? "오늘" : `D-${n}`;
const sub = always ? "언제든 신청" : st.status === "open" ? (n === 0 ? "마감" : "마감까지") : st.status === "upcoming" ? "접수 시작까지" : n === 0 ? "활동일" : "다음 활동일까지";

// Stations this benefit sits at: every live field whose live lines pass the step.
const stations = e.stepIds.flatMap((sid) =>
  fields
    .filter((f) => !f.retired && f.paths.some((p) => !p.retired && p.steps.some((s) => s.step === sid)))
    .map((f) => ({ href: url(`/fields/${f.id}#st-${sid}`), field: f.title, station: steps.get(sid)?.title ?? sid })),
);

// 비슷한 혜택: same kind, never another region's (rules in similarTo, lib/board.ts).
const similar = similarTo(e, boardEntries(), today);

// Windows or sessions, when there is more than one.
// 봉사 rounds share one apply window, so the activity day leads; exams lead with the apply window.
const winList = e.windows.map((w) =>
  e.kind === "volunteer" && w.ev
    ? { s: w.s, e: w.e, label: `활동 ${ymd(w.ev)}`, sub: `신청 ${md(w.s)}~${md(w.e)}` }
    : { s: w.s, e: w.e, label: `신청 ${rangeLabel(w.s, w.e)}`, sub: [w.k, w.ev && `${e.kind === "exam" ? "시험" : "활동"} ${ymd(w.ev)}`].filter(Boolean).join(" · ") },
);
const sesItems = winList.length ? winList : e.sessions.map((d) => ({ s: d, e: d, label: ymd(d), sub: "" }));
const SHOW = 6;
const listTitle = e.kind === "exam" ? "접수 회차" : e.kind === "activity" ? "활동일" : "회차";
const multi = winList.length > 1 || e.sessions.length > 1;
const seen = e.seen ? e.seen.replaceAll("-", ".") : "";
const pageTitle = `${e.title} · ${e.kindLabel}`;
// Search snippet: who runs it, what you get, and until when, before the summary (people search the name).
const when = st.window
  ? st.status === "open" ? `${ymd(st.window.e)} 마감` : `${ymd(st.window.s)}부터 신청`
  : always ? "상시 신청" : st.date ? `다음 활동 ${ymd(st.date)}` : "";
const clip = (t: string, max: number) => (t.length > max ? `${t.slice(0, max - 1).trimEnd()}…` : t);
const cost = clip(e.cost.split("※")[0].trim(), 40);
const what = !cost ? e.kindLabel
  : e.kind === "scholarship" || e.kind === "support" ? `${e.kindLabel} ${cost}` : `${e.kindLabel} · ${e.kind === "exam" ? "응시료" : "비용"} ${cost}`;
const desc = clip([e.provider, e.regionLabel !== "전국" ? e.regionLabel : "", what, when].filter(Boolean).join(" · ") + ". " + (e.summary || ""), 160).trim();
const pageUrl = new URL(Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href;

// JSON-LD: a WebPage about the service; GovernmentService for public providers, Service otherwise.
// The application window is an Offer (validFrom/validThrough), which is where schema.org puts such dates.
const GOV_SOURCES = new Set(["gov24", "qnet"]);
const deadline = st.window?.e;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage", "@id": pageUrl, url: pageUrl, name: e.title, description: desc, inLanguage: "ko",
      ...(e.seen ? { dateModified: e.seen } : {}),
      isPartOf: { "@type": "WebSite", name: "지금 내 자리에서", url: new URL(url("/"), Astro.site).href },
      breadcrumb: {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "혜택", item: new URL(url("/helps/"), Astro.site).href },
          { "@type": "ListItem", position: 2, name: e.title, item: pageUrl },
        ],
      },
      mainEntity: {
        "@type": GOV_SOURCES.has(e.source) ? "GovernmentService" : "Service",
        name: e.title, description: e.summary || desc, url: e.url, serviceType: e.kindLabel,
        ...(e.provider ? { provider: { "@type": "Organization", name: e.provider } } : {}),
        areaServed: e.regions.includes("all") ? { "@type": "Country", name: "대한민국" } : e.regionLabel.split(" · ").map((r) => ({ "@type": "AdministrativeArea", name: r })),
        ...(e.target ? { audience: { "@type": "Audience", audienceType: clip(e.target, 200) } } : {}),
        ...(st.window || always ? {
          offers: {
            "@type": "Offer", url: e.url, availability: "https://schema.org/InStock",
            ...(e.cost ? { description: e.cost } : {}),
            ...(st.window ? { validFrom: st.window.s } : {}),
            ...(deadline ? { validThrough: deadline } : {}),
          },
        } : {}),
      },
    },
  ],
};
const ldJson = JSON.stringify(ld).replace(/</g, "\\u003c");
---
<Site title={pageTitle} description={desc}>
  <script slot="head" type="application/ld+json" is:inline set:html={ldJson}></script>
  <main class="hd" style={`--c:${KIND_COLOR[e.kind]}`}>
    <p class="crumb"><a href={url("/helps/")}>← 혜택 전체</a></p>

    <header class="head">
      <p class="kind"><i aria-hidden="true"></i>{e.kindLabel}<span class="status" id="status">{STATUS_LABEL[st.status]}</span></p>
      <div class="title-row">
        <h1>{e.title}</h1>
        <p class:list={["dd", `s-${st.status}`, { urgent: st.status === "open" && n <= 7 }]} id="dd">
          <b>{dd}</b><small>{sub}</small>
        </p>
      </div>
      <p class="prov">{e.provider}<ViewCount /></p>
      <p class="tier"><span class="t-auto">공식 자동</span><span>출처 {e.sourceLabel}</span>{seen && <span>{seen} 확인</span>}<span>기관 원문에서 한 번 더 확인하세요</span></p>
    </header>

    <div class="grid">
      <div class="main">
        {e.summary && <p class="summary">{e.summary}</p>}

        <table class="info">
          <caption class="sr">{e.title} 안내</caption>
          <tbody>
            {e.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td>{r.list?.length ? (r.list.length > 1 ? <ul>{r.list.map((x) => <li>{x}</li>)}</ul> : r.list[0]) : r.value}</td>
              </tr>
            ))}
          </tbody>
        </table>

        {multi && (
          <section class="sessions" aria-labelledby="ses-h">
            <h2 id="ses-h">{listTitle} {winList.length || e.sessions.length}개</h2>
            <ol class="ses-list">
              {sesItems.slice(0, SHOW).map((w) => <li data-e={w.e} data-s={w.s}><span>{w.label}</span>{w.sub && <small>{w.sub}</small>}</li>)}
            </ol>
            {sesItems.length > SHOW && (
              <details class="more">
                <summary>{sesItems.length - SHOW}개 더 보기</summary>
                <ol class="ses-list">
                  {sesItems.slice(SHOW).map((w) => <li data-e={w.e} data-s={w.s}><span>{w.label}</span>{w.sub && <small>{w.sub}</small>}</li>)}
                </ol>
              </details>
            )}
          </section>
        )}

        <a class="go" href={e.url} target="_blank" rel="noopener">
          <span class="go-t"><small>{e.sourceLabel} · 새 창</small><b>원문 공고 보기 ↗</b></span>
        </a>
        {e.source === "certi" && <p class="fine">신청 마감일은 원문에 따로 나오지 않을 수 있어요. 운영 기관에 활동일 전에 확인해 주세요.</p>}

        <div class="share" id="share" hidden>
          <button type="button" id="copy" data-url={pageUrl}>링크 복사</button>
          <button type="button" id="native" hidden>공유하기</button>
          <span class="copied" id="copied" role="status"></span>
        </div>
      </div>

      <aside class="side">
        {stations.length > 0 && (
          <section aria-labelledby="st-h">
            <h2 id="st-h">이 혜택이 있는 역</h2>
            <ul class="links">
              {stations.map((s) => <li><a href={s.href}><b>{s.station}</b><small>{s.field} 노선도</small></a></li>)}
            </ul>
          </section>
        )}
        {similar.length > 0 && (
          <section aria-labelledby="sim-h">
            <h2 id="sim-h">비슷한 {e.kindLabel}</h2>
            <ul class="links">
              {similar.map((o) => {
                const os = stateOn(o, today);
                return (
                  <li><a href={url(`/helps/${o.id}/`)}><b>{o.title}</b><small>{o.regionLabel} · {os.window ? `신청 ${rangeLabel(os.window.s, os.window.e)}` : os.status === "always" ? "상시 신청" : os.date ? `활동 ${ymd(os.date)}` : ""}</small></a></li>
                );
              })}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </main>

  <script type="application/json" id="hd-data" set:html={JSON.stringify({ w: e.windows.map((w) => [w.s, w.e]), s: e.sessions, a: e.always })}></script>
  <script is:inline>
    (() => {
      const pad = (n) => String(n).padStart(2, "0");
      const now = new Date();
      const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      const days = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 864e5);
      // Re-judge the state from today's date (same rule as the list), fade past rounds, mark the next one.
      const T = JSON.parse(document.getElementById("hd-data").textContent);
      const w = T.w.filter((v) => v[1] >= today), ss = T.s.filter((d) => d >= today);
      let state = "closed", date = "", cur = null;
      if (w.length) {
        const open = w.find((v) => v[0] <= today);
        cur = open || w[0];
        state = open ? "open" : "upcoming"; date = open ? cur[1] : cur[0];
      } else if (ss.length) { state = "check"; date = ss[0]; cur = [ss[0], ss[0]]; }
      else if (T.a) state = "always";
      document.querySelectorAll(".ses-list li").forEach((li) => {
        li.classList.toggle("past", li.dataset.e < today);
        li.classList.toggle("next", !!cur && li.dataset.s === cur[0] && li.dataset.e === cur[1]);
      });
      const dd = document.getElementById("dd");
      const L = { open: "접수 중", upcoming: "곧 열림", check: "일정 확인", always: "상시" };
      if (state === "always") {
        dd.className = "dd s-always";
        document.getElementById("status").textContent = L.always;
      } else if (state === "closed") {
        dd.className = "dd s-closed";
        dd.querySelector("b").textContent = "마감";
        dd.querySelector("small").textContent = "다음 공고를 기다려요";
        document.getElementById("status").textContent = "이번에는 마감";
      } else {
        const n = days(today, date);
        dd.className = `dd s-${state}${state === "open" && n <= 7 ? " urgent" : ""}`;
        dd.querySelector("b").textContent = n === 0 ? "오늘" : `D-${n}`;
        dd.querySelector("small").textContent = state === "open" ? (n === 0 ? "마감" : "마감까지") : state === "upcoming" ? "접수 시작까지" : n === 0 ? "활동일" : "다음 활동일까지";
        document.getElementById("status").textContent = L[state];
      }

      // Share: copy the link, and the system share sheet where the browser has one.
      const share = document.getElementById("share");
      const copy = document.getElementById("copy"), native = document.getElementById("native"), said = document.getElementById("copied");
      share.hidden = false;
      const link = copy.dataset.url;
      copy.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(link); said.textContent = "링크를 복사했어요"; }
        catch { window.prompt("이 주소를 복사하세요", link); }
      });
      if (navigator.share) {
        native.hidden = false;
        native.addEventListener("click", () => navigator.share({ title: document.title, url: link }).catch(() => {}));
      }
    })();
  </script>
</Site>

<style>
  .hd { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
  .crumb { margin: 14px 0 0; font-size: 15px; }
  .crumb a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; text-underline-offset: 3px; }
  .head { padding: 6px 0 14px; border-bottom: 3px solid var(--ink); }
  .kind { margin: 0; display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; }
  .kind i { width: 26px; height: 7px; border-radius: 4px; background: var(--c); }
  .status { font-weight: 600; color: var(--ink-2); padding-left: 8px; border-left: 1px solid var(--rule); }
  .title-row { display: flex; gap: 14px; align-items: flex-start; justify-content: space-between; margin-top: 6px; }
  h1 { margin: 0; font: 400 clamp(28px, 7.4vw, 44px)/1.2 var(--display); letter-spacing: -0.01em; min-width: 0; }
  .dd {
    flex: none; margin: 4px 0 0; width: 84px; min-height: 64px; padding: 6px 4px; border: 2.5px solid var(--ink); background: #fff;
    display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
  }
  .dd b { font: 400 24px/1.1 var(--display); font-variant-numeric: tabular-nums; }
  .dd small { font-size: 12px; font-weight: 600; color: var(--ink-2); line-height: 1.3; }
  .dd.urgent { background: var(--carrot); border-color: var(--carrot); color: #fff; }
  .dd.urgent small { color: #fff; }
  .dd.s-upcoming { border-style: dashed; }
  .dd.s-check { border-color: var(--lead); background: var(--board); }
  .dd.s-always { border-color: var(--c); background: color-mix(in srgb, var(--c) 10%, #fff); }
  .dd.s-closed { border-color: var(--lead); color: var(--ink-2); }
  .prov { margin: 6px 0 0; font-size: 15px; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .tier { margin: 10px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 2px 0; font-size: 13px; color: var(--ink-2); }
  .tier > span + span::before { content: "·"; margin: 0 6px; }
  .t-auto { font-weight: 700; border: 1.5px dashed var(--lead); padding: 0 6px; line-height: 20px; border-radius: 2px; }

  .grid { display: grid; gap: 28px; margin-top: 18px; }
  .main { min-width: 0; }
  .summary { margin: 0 0 14px; font-size: 17px; line-height: 1.65; }
  .info { width: 100%; border-collapse: collapse; border-top: 2px solid var(--ink); }
  .info th, .info td { padding: 10px 0; border-bottom: 1px solid var(--rule); vertical-align: top; text-align: left; font-size: 15.5px; line-height: 1.6; }
  .info th { width: 6.6em; white-space: nowrap; padding-right: 14px; font-weight: 700; color: var(--ink-2); font-size: 14px; }
  .info td { overflow-wrap: anywhere; }
  .info ul { margin: 0; padding-left: 1.1em; }
  .info li + li { margin-top: 2px; }

  .sessions { margin-top: 22px; }
  .sessions h2, .side h2 { margin: 0 0 6px; font: 400 20px/1.3 var(--display); }
  .sessions ol { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); columns: 1; }
  .sessions .more ol { border-top: 0; }
  .more summary {
    list-style: none; min-height: 44px; display: flex; align-items: center; cursor: pointer;
    font-size: 15px; font-weight: 600; color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px;
  }
  .more summary::-webkit-details-marker { display: none; }
  .sessions li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 12px; padding: 7px 0; border-bottom: 1px dotted var(--rule); font-size: 15px; font-variant-numeric: tabular-nums; break-inside: avoid; }
  .sessions li small { color: var(--ink-2); font-size: 14px; }
  .sessions li.past { color: var(--lead); text-decoration: line-through; }
  .sessions li.past small { color: var(--lead); }
  .sessions li.next { font-weight: 700; box-shadow: inset 4px 0 0 var(--c); padding-left: 10px; }

  .go {
    display: flex; margin-top: 24px; text-decoration: none; background: var(--ink); color: #fff; min-height: 64px;
    border-bottom: 8px solid var(--c);
  }
  .go-t { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 8px 16px; }
  .go-t small { font-size: 13px; opacity: 0.8; }
  .go-t b { font: 400 24px/1.25 var(--display); }
  .go:hover .go-t b { text-decoration: underline; text-underline-offset: 5px; }
  .fine { margin: 8px 0 0; font-size: 14px; color: var(--ink-2); }

  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; margin-top: 12px; }
  .share button {
    min-height: 44px; padding: 0 14px; border: 1.5px solid var(--ink); background: #fff; border-radius: 2px;
    font-size: 15px; font-weight: 600; cursor: pointer;
  }
  .share button:hover { background: var(--board); }
  .copied { font-size: 14px; color: var(--me); font-weight: 600; }

  .side section + section { margin-top: 26px; }
  .links { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .links li { border-bottom: 1px solid var(--rule); }
  .links a { display: flex; flex-direction: column; padding: 10px 2px; text-decoration: none; min-height: 44px; }
  .links b { font-weight: 700; font-size: 16px; line-height: 1.4; }
  .links small { font-size: 14px; color: var(--ink-2); }
  .links a:hover b { text-decoration: underline; text-decoration-color: var(--c); text-decoration-thickness: 3px; text-underline-offset: 3px; }

  @media (min-width: 900px) {
    .hd { padding: 0 40px; }
    .crumb { margin-top: 24px; }
    .dd { width: 96px; min-height: 72px; }
    .dd b { font-size: 28px; }
    .grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; margin-top: 24px; }
    .info th { width: 8em; font-size: 15px; }
    .sessions ol { columns: 2; column-gap: 28px; }
    .side { padding-top: 2px; }
  }
</style>
