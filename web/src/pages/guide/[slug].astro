---
// Guide article (D22): a reading column for phones, headings in the display face, the weekly mission as a sticky note,
// then the way to the field's 노선도 and the checked sources.
import { getCollection, render } from "astro:content";
import Site from "../../layouts/Site.astro";
import { fields } from "../../lib/content";

export async function getStaticPaths() {
  // Drafts are visible in `astro dev` only, never in the built site.
  const posts = await getCollection("guide", (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, updated, sources, draft, field } = post.data;
const fieldData = field ? fields.find((f) => f.id === field) : undefined;
const fieldTitle = fieldData?.title ?? "이 분야";
const pathCount = fieldData?.paths.filter((p) => !p.retired).length;
const iso = updated.toISOString().slice(0, 10);
---
<Site title={title} description={description} noindex={draft}>
  <main class="wrap">
    <article class="guide">
      <header class="head">
        <p class="crumbs"><a href="/guide">읽을거리</a>{fieldData && <span class="fld">{fieldData.title} 노선</span>}</p>
        {draft && <p class="draft">초안 · 팀 검토 전이에요</p>}
        <h1 class="display">{title}</h1>
        <p class="meta"><time datetime={iso}>{iso.replaceAll("-", ".")}</time> 업데이트</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      {field && (
        <a class="go" href={`/fields/${field}`}>
          <span class="go-t">
            <small>{pathCount ? `노선 ${pathCount}개를 나란히 봐요` : "길을 나란히 봐요"}</small>
            <b>{fieldTitle} 노선도 보기</b>
          </span>
          <span class="go-arrow" aria-hidden="true">→</span>
        </a>
      )}

      {sources.length > 0 && (
        <section class="sources" aria-labelledby="src-h">
          <h2 id="src-h">출처</h2>
          <p class="src-note">이 글의 사실은 아래 공식 안내로 확인했어요. 바뀔 수 있으니 신청 전에 한 번 더 봐요.</p>
          <ol>
            {sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
                <span class="checked"><span class="tick" aria-hidden="true"></span>확인 <time datetime={s.checked_at}>{s.checked_at}</time></span>
              </li>
            ))}
          </ol>
        </section>
      )}
    </article>
  </main>
</Site>

<style>
  .wrap { padding: 0 16px; }
  .guide { max-width: 680px; margin: 0 auto; }
  .head { padding: 26px 0 20px; border-bottom: 2px solid var(--ink); }
  .crumbs { margin: 0 0 10px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; font-size: 15px; color: var(--ink-2); }
  .crumbs a { font-weight: 600; color: var(--ink); min-height: 32px; display: inline-flex; align-items: center; }
  .fld::before { content: ""; display: inline-block; width: 18px; height: 5px; margin-right: 6px; vertical-align: middle; background: var(--line-1); border-radius: 3px; }
  .draft { display: inline-block; margin: 0 0 10px; padding: 2px 10px; border: 2px solid var(--ink); background: var(--board); font-size: 14px; font-weight: 700; }
  h1 { margin: 0; font-size: clamp(34px, 9vw, 50px); line-height: 1.15; }
  .meta { margin: 10px 0 0; font-size: 14px; color: var(--ink-2); }

  /* ---------- reading column ---------- */
  .prose { font-size: 18px; line-height: 1.85; padding-top: 8px; }
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose > :global(p:first-child) { font-size: 19px; }
  .prose :global(h2) {
    margin: 2.2em 0 0.6em; font: 400 28px/1.3 var(--display); letter-spacing: -0.01em;
    padding-top: 14px; border-top: 1px solid var(--rule);
  }
  .prose :global(h3) { margin: 1.9em 0 0.5em; font: 400 22px/1.35 var(--display); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.2em; padding-left: 1.3em; }
  .prose :global(li) { margin: 0.35em 0; }
  .prose :global(li::marker) { color: var(--ink-2); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(a) { text-decoration-color: var(--line-1); text-decoration-thickness: 2px; text-underline-offset: 4px; font-weight: 600; }
  .prose :global(a:hover) { text-decoration-thickness: 3px; }

  /* the weekly mission: a sticky note with a strip of tape, a light touch of the scrapbook concept */
  .prose :global(blockquote) {
    position: relative; margin: 1.6em 4px 1.8em; padding: 24px 20px 18px;
    background: var(--mark); transform: rotate(-0.8deg);
    box-shadow: 0 12px 16px -12px rgba(70, 50, 0, 0.4), inset 0 -16px 22px -20px rgba(140, 100, 0, 0.35);
    font-family: var(--bubble); font-size: 18px; line-height: 1.75;
  }
  .prose :global(blockquote::before) {
    content: ""; position: absolute; top: -11px; left: 50%; width: 92px; height: 22px; margin-left: -46px;
    background: rgba(255, 255, 255, 0.55); border: 1px solid rgba(27, 31, 42, 0.08); transform: rotate(2deg);
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(blockquote strong) {
    display: block; width: fit-content; margin-bottom: 6px; font: 400 22px/1.3 var(--display);
    background: linear-gradient(transparent 62%, rgba(184, 86, 47, 0.28) 62%);
  }

  /* ---------- way on ---------- */
  .go {
    display: flex; align-items: stretch; margin-top: 40px; text-decoration: none; background: #fff;
    border: 2px solid var(--ink); border-bottom: 8px solid var(--line-1); min-height: 64px;
  }
  .go-t { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 8px 14px; }
  .go-t small { font-size: 14px; color: var(--ink-2); }
  .go-t b { font: 400 23px/1.25 var(--display); }
  .go-arrow { display: grid; place-items: center; width: 64px; background: var(--ink); color: #fff; font-size: 26px; font-weight: 700; }
  .go:hover .go-t b { text-decoration: underline; text-decoration-color: var(--line-1); text-decoration-thickness: 3px; text-underline-offset: 4px; }

  /* ---------- sources ---------- */
  .sources { margin-top: 44px; }
  .sources h2 { margin: 0; font: 400 20px/1.3 var(--display); }
  .src-note { margin: 4px 0 10px; font-size: 14px; color: var(--ink-2); }
  .sources ol { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); counter-reset: src; }
  .sources li {
    counter-increment: src; display: grid; grid-template-columns: 28px 1fr; column-gap: 6px;
    padding: 10px 2px; border-bottom: 1px solid var(--rule); font-size: 15px; line-height: 1.55;
  }
  .sources li::before { content: counter(src); grid-row: span 2; font-size: 13px; font-weight: 700; color: var(--ink-2); padding-top: 2px; }
  .sources a { text-decoration-color: var(--lead); text-underline-offset: 3px; }
  .sources a::after { content: " ↗"; color: var(--ink-2); }
  .checked { display: inline-flex; align-items: center; gap: 6px; margin-top: 2px; font-size: 13px; color: var(--ink-2); }
  .tick { width: 12px; height: 7px; border-left: 2px solid var(--line-1); border-bottom: 2px solid var(--line-1); transform: rotate(-45deg) translateY(-2px); }

  @media (min-width: 900px) {
    .head { padding-top: 56px; }
    .prose { font-size: 19px; }
    .prose :global(h2) { font-size: 32px; }
    .prose :global(blockquote) { max-width: 560px; margin-left: -16px; padding: 28px 28px 22px; transform: rotate(-1.2deg); }
    .sources li { grid-template-columns: 28px 1fr auto; column-gap: 16px; align-items: baseline; }
    .sources li::before { grid-row: auto; }
    .checked { margin-top: 0; white-space: nowrap; }
  }
</style>
