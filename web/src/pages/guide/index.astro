---
// Guide list (D22): articles as stations on one ink line, newest first. Drafts show in `astro dev` only.
import { getCollection } from "astro:content";
import Site from "../../layouts/Site.astro";
import { fields } from "../../lib/content";

const posts = (await getCollection("guide", (p) => import.meta.env.DEV || !p.data.draft))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
const fieldTitle = (id?: string) => (id ? fields.find((f) => f.id === id)?.title : undefined);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---
<Site title="읽을거리" description="진로를 고민할 때 읽어 보면 좋은 글. 상황별 선택지와 직업별 여러 길을 공식 출처로 확인해 정리해요.">
  <main class="guide-list">
    <header class="head">
      <p class="eyebrow">읽을거리</p>
      <h1 class="display">천천히 읽는 길 안내</h1>
      <div class="row">
        <span class="face" aria-hidden="true">길잡이</span>
        <p class="b">상황별 선택지와 직업별 여러 길을 정리해요. 사실은 공식 출처로 확인하고, 확인한 날짜를 글 끝에 적어 둬요.</p>
      </div>
    </header>

    {posts.length === 0 ? (
      <p class="empty">첫 글을 준비하고 있어요.</p>
    ) : (
      <ol class="list">
        {posts.map((p) => {
          const ft = fieldTitle(p.data.field);
          return (
            <li>
              <span class="dot" aria-hidden="true"></span>
              <a href={`/guide/${p.id}`}>
                <span class="meta">
                  <time datetime={iso(p.data.updated)}>{iso(p.data.updated).replaceAll("-", ".")}</time>
                  {ft && <span class="fld">{ft} 노선</span>}
                  {p.data.draft && <span class="draft">초안</span>}
                </span>
                <b>{p.data.title}</b>
                <span class="desc">{p.data.description}</span>
              </a>
            </li>
          );
        })}
        <li class="end">
          <span class="dot" aria-hidden="true"></span>
          <p>다음 글을 쓰고 있어요.</p>
        </li>
      </ol>
    )}
  </main>
</Site>

<style>
  .guide-list { max-width: 760px; margin: 0 auto; padding: 0 16px; }
  .head { padding: 28px 0 8px; }
  .eyebrow { margin: 0 0 4px; font-size: 15px; font-weight: 600; color: var(--ink-2); }
  h1 { margin: 0; font-size: clamp(34px, 9vw, 52px); line-height: 1.1; }
  .row { display: flex; gap: 8px; align-items: flex-start; margin-top: 20px; max-width: 520px; }
  .face {
    flex: none; width: 40px; height: 40px; border-radius: 14px; background: var(--me); color: var(--me-ink);
    display: grid; place-items: center; font: 600 11px var(--ui); letter-spacing: -0.02em;
  }
  .b {
    margin: 0; font: 17px/1.6 var(--bubble); padding: 10px 14px; border-radius: 4px 18px 18px 18px;
    background: var(--bubble-bg); box-shadow: 0 1px 0 rgba(27, 31, 42, 0.08);
  }
  .empty { margin-top: 32px; }

  /* one ink line, each article a station on it */
  .list { list-style: none; margin: 32px 0 0; padding: 0; border-top: 2px solid var(--ink); position: relative; }
  .list::before { content: ""; position: absolute; left: 11px; top: 0; bottom: 28px; width: 6px; background: var(--ink); border-radius: 0 0 3px 3px; }
  .list li { position: relative; border-bottom: 1px solid var(--rule); padding-left: 44px; }
  .list .dot { position: absolute; left: 5px; top: 22px; width: 18px; height: 18px; border-radius: 50%; background: #fff; border: 3.5px solid var(--ink); z-index: 1; }
  .list a { display: flex; flex-direction: column; gap: 4px; padding: 18px 2px 20px; text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-size: 14px; color: var(--ink-2); }
  .fld::before { content: ""; display: inline-block; width: 18px; height: 5px; margin-right: 6px; vertical-align: middle; background: var(--line-1); border-radius: 3px; }
  .draft { padding: 0 6px; border: 1.5px solid var(--ink-2); font-size: 12px; font-weight: 600; line-height: 1.6; }
  .list b { font: 400 24px/1.3 var(--display); }
  .desc { color: var(--ink-2); font-size: 16px; line-height: 1.6; }
  .list a:hover b { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .list .end { border-bottom: 0; }
  .list .end .dot { top: 16px; border-color: var(--lead); border-style: dashed; }
  .list .end p { margin: 0; padding: 14px 2px; color: var(--ink-2); font-size: 15px; }

  @media (min-width: 900px) {
    .head { padding-top: 56px; }
    .list a { padding: 22px 2px 24px; }
    .list .dot { top: 26px; }
  }
</style>
