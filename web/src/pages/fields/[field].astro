---
import Base from "../../layouts/Base.astro";
import {
  fields, steps, helps, helpsForStep, helpsForField,
  KIND_LABEL, HELP_LABEL, REGION_LABEL, COST_LABEL, type Field, type Help,
} from "../../lib/content";

export function getStaticPaths() {
  return fields.map((f) => ({ params: { field: f.id }, props: { field: f } }));
}
const { field } = Astro.props as { field: Field };
const paths = field.paths.filter((p) => !p.retired);
const fieldHelps = helpsForField(field.id);
const stepIds = new Set(paths.flatMap((p) => p.steps.map((s) => s.step)));
const fieldHasHelps = fieldHelps.length > 0 || helps.some((h) => h.step_ids?.some((id) => stepIds.has(id)));

// A step shown in full in an earlier path is folded in later paths, so each path's difference stands out.
const firstPathOf = new Map<string, number>();
paths.forEach((p, i) => p.steps.forEach((s) => { if (!firstPathOf.has(s.step)) firstPathOf.set(s.step, i); }));

const regionText = (h: Help) => (h.regions.includes("all") ? "전국" : h.regions.map((r) => REGION_LABEL[r] ?? r).join("·"));
const deadlineText = (h: Help) => (h.deadline === "rolling" ? "상시" : h.deadline ? `마감 ${h.deadline}` : null);
const ageText = (h: Help) =>
  h.age_min != null || h.age_max != null ? `${h.age_min ?? ""}~${h.age_max ?? ""}세` : null;
---
<Base title={`${field.title} 길 지도`} description={field.summary} wide>
  <header class="intro">
    <p class="eyebrow">길 지도</p>
    <h1>{field.title} 길 지도</h1>
    <p class="lead">{field.summary}</p>
    <p class="muted">어느 길이 더 낫다고 정하지 않아요. 나란히 보고 지금 내 상황에 맞는 길을 골라 보세요.</p>
  </header>

  {!fieldHasHelps && (
    <p class="pending">
      <strong>도움 정보는 확인하는 중이에요.</strong> 길마다 받을 수 있는 지원·대회·체험을 공식 출처로 하나씩 확인해서 채울게요.
      <span class="muted">(2026-09-26 기준)</span>
    </p>
  )}

  <nav class="jump" aria-label="길 바로가기">
    {paths.map((p, i) => (
      <a href={`#${p.id}`}><span class="num">{i + 1}</span>{p.title}</a>
    ))}
  </nav>
  <p class="legend muted"><span class="dot green" aria-hidden="true"></span> 초록 점은 먼저 가볍게 해 보는 단계예요</p>

  <div class="paths">
    {paths.map((p, i) => (
      <section class="path" id={p.id}>
        <div class="path-head">
          <span class="num big">{i + 1}</span>
          <div>
            <h2>{p.title}</h2>
            <p class="muted">{p.summary}</p>
          </div>
        </div>
        <ol class="timeline">
          {p.steps.map((ps) => {
            const s = steps.get(ps.step);
            if (!s) return null;
            const hs = helpsForStep(s.id);
            const first = firstPathOf.get(s.id);
            const repeated = first !== undefined && first < i;
            const body = (
              <>
                <p>{s.summary}</p>
                {s.official_url && <p class="link"><a href={s.official_url} rel="noopener">공식 안내 보기</a></p>}
                {hs.length > 0 && (
                  <ul class="helps">
                    {hs.map((h) => (
                      <li>
                        <span class="pill help">{HELP_LABEL[h.type]}</span>
                        <a href={h.url} rel="noopener">{h.title}</a>
                        <span class="meta">
                          <span class="chip">{regionText(h)}</span>
                          {deadlineText(h) && <span class="chip">{deadlineText(h)}</span>}
                          {ageText(h) && <span class="chip">{ageText(h)}</span>}
                          {h.cost && <span class="chip">{COST_LABEL[h.cost]}</span>}
                          {h.sponsored && <span class="chip">후원</span>}
                        </span>
                        <span class="muted small">{h.provider} · {h.checked_at} 확인</span>
                      </li>
                    ))}
                  </ul>
                )}
              </>
            );
            return (
              <li class:list={["step", `k-${s.kind}`, { repeated }]}>
                <div class="step-head">
                  <span class="pill">{KIND_LABEL[s.kind] ?? s.kind}</span>
                  <strong>{s.title}</strong>
                </div>
                {ps.note && <p class="note">{ps.note}</p>}
                {repeated ? (
                  <details>
                    <summary>{first + 1}번 길과 같은 단계예요 · 펼쳐 보기</summary>
                    {body}
                  </details>
                ) : body}
              </li>
            );
          })}
        </ol>
      </section>
    ))}
  </div>

  {fieldHelps.length > 0 && (
    <section class="field-helps">
      <h2>{field.title} 분야 전체에 쓸 수 있는 도움</h2>
      <ul>{fieldHelps.map((h) => <li><span class="pill help">{HELP_LABEL[h.type]}</span> <a href={h.url} rel="noopener">{h.title}</a> <span class="chip">{regionText(h)}</span> <span class="muted small">{h.provider}</span></li>)}</ul>
    </section>
  )}
</Base>

<style>
  .intro { max-width: 720px; }
  .eyebrow { color: var(--accent-ink); font-weight: 700; margin: 0; }
  .lead { font-size: 18px; }
  .pending { margin: 16px 0 0; font-size: 15px; background: var(--soft); border: 1px solid #f3dccd; border-radius: 12px; padding: 10px 14px; max-width: 720px; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 6px; }
  .jump a { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--ink); text-decoration: none; font-size: 15px; }
  .jump a:hover { border-color: var(--accent); }
  .legend { font-size: 14px; margin: 4px 0 0; display: flex; align-items: center; gap: 6px; }
  .dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 3px solid var(--accent); background: var(--card); }
  .dot.green { border-color: #3a9d6e; }
  .num { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); color: #fff; font-size: 13px; font-weight: 800; flex: none; }
  .num.big { width: 32px; height: 32px; font-size: 16px; }

  .paths { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 18px; margin-top: 16px; }
  .path { border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; background: var(--card); scroll-margin-top: 72px; }
  .path-head { display: flex; gap: 12px; align-items: flex-start; }
  .path-head h2 { margin: 0 0 2px; font-size: 19px; }
  .path-head p { margin: 0; }

  .timeline { list-style: none; margin: 18px 0 0; padding: 0 0 0 18px; border-left: 2px dashed #f1c7b2; }
  .step { position: relative; margin: 0 0 16px; padding-left: 12px; }
  .step::before { content: ""; position: absolute; left: -27px; top: 7px; width: 14px; height: 14px; border-radius: 50%; background: var(--card); border: 3px solid var(--accent); }
  .step.k-mission::before, .step.k-experience::before { border-color: #3a9d6e; }
  .step.repeated::before { border-color: #d9d4ce; }
  .step.repeated .step-head strong { color: var(--muted); font-weight: 600; }
  .step-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .step p { margin: 4px 0; }
  details summary { cursor: pointer; font-size: 14px; color: var(--muted); margin-top: 2px; }
  .note { font-size: 15px; background: var(--soft); border-radius: 8px; padding: 4px 10px; }
  .link { font-size: 15px; }
  .helps { list-style: none; padding: 0; margin: 8px 0 0; font-size: 15px; }
  .helps li { margin: 8px 0; }
  .meta { display: inline-flex; flex-wrap: wrap; gap: 4px; margin-left: 4px; vertical-align: 1px; }
  .chip { font-size: 12px; border: 1px solid var(--line); border-radius: 6px; padding: 0 6px; color: var(--muted); background: var(--bg); }
  .small { display: block; font-size: 13px; }
  .pill.help { background: #e3f2ea; color: #226b49; }
  .field-helps { margin-top: 36px; }
</style>
