---
// 분야 길 지도 (D22): a short conversation, then the subway map with the fitting line lit,
// and the benefits that fit the answers beside it (under it on phones): verified helps first, then the quieter
// "공식 자동" items the crawler collected from official sources (data/collected, see lib/collected.ts).
// Rule-based and page-only: answers never leave the browser tab.
import Site from "../../layouts/Site.astro";
import PerkCard from "../../components/field/PerkCard.astro";
import { fields, steps, helps, KIND_LABEL, REGION_LABEL, COST_LABEL, HELP_LABEL, type Field, type Path, type Help } from "../../lib/content";
import { autoGroups } from "../../lib/collected";

type LearnStyle = "hands" | "study" | "institution" | "school";
type FieldX = Field & { try_phrase?: string; paths: (Path & { learn_style?: LearnStyle })[] };

export function getStaticPaths() {
  return fields.map((f) => ({ params: { field: f.id }, props: { field: f } }));
}
const { field } = Astro.props as { field: FieldX };
const paths = field.paths.filter((p) => !p.retired);

// When the benefits list was last stated as "being checked"; shown with the empty state.
const CHECKING_AS_OF = "2026-09-26";
const today = new Date().toISOString().slice(0, 10);

// Korean particles: pick the form by whether the word ends in a final consonant (받침).
const batchim = (w: string) => {
  const c = w.trim().charCodeAt(w.trim().length - 1);
  return c >= 0xac00 && c <= 0xd7a3 && (c - 0xac00) % 28 !== 0;
};
const iga = (w: string) => w + (batchim(w) ? "이" : "가");
const KNUM: Record<number, string> = { 1: "한", 2: "두", 3: "세", 4: "네", 5: "다섯", 6: "여섯" };

// ---------- subway map, computed from the data ----------
const PALETTE = ["var(--line-1)", "var(--line-2)", "var(--line-3)", "var(--line-4)", "#7b52ae", "#0a93ad", "#8a5a2b", "#5c6b00"];
const lines = paths.map((p, i) => ({
  id: p.id,
  title: p.title,
  summary: p.summary,
  color: PALETTE[i % PALETTE.length],
  steps: p.steps.map((s) => s.step),
}));

type Station = { id: string; lines: number[]; notes: Record<number, string>; preds: Set<string> };
const stations = new Map<string, Station>();
paths.forEach((p, li) =>
  p.steps.forEach((ps, i) => {
    const st = stations.get(ps.step) ?? { id: ps.step, lines: [], notes: {}, preds: new Set<string>() };
    if (!st.lines.includes(li)) st.lines.push(li);
    if (ps.note) st.notes[li] = ps.note;
    if (i > 0) st.preds.add(p.steps[i - 1].step);
    stations.set(ps.step, st);
  }),
);

const order: string[] = [];
const placed = new Set<string>();
let last: string | null = null;
const isNextOf = (prev: string, id: string) =>
  lines.some((l) => {
    const i = l.steps.indexOf(prev);
    return i >= 0 && l.steps[i + 1] === id;
  });
while (order.length < stations.size) {
  const unplaced = [...stations.values()].filter((s) => !placed.has(s.id));
  let avail = unplaced.filter((s) => [...s.preds].every((p) => placed.has(p)));
  if (!avail.length) avail = unplaced;
  avail.sort((a, b) => Math.min(...a.lines) - Math.min(...b.lines));
  const pick = (last && avail.find((s) => isNextOf(last!, s.id))) || avail[0];
  order.push(pick.id);
  placed.add(pick.id);
  last = pick.id;
}
const pos = new Map(order.map((id, i) => [id, i]));
const inField = new Set(order);
const lineSegs = lines.map((l, li) => ({ ...l, lane: li, a: pos.get(l.steps[0])!, b: pos.get(l.steps[l.steps.length - 1])! }));

// "아직 없어요" points to the field's first mission step, if it has one.
const mission = order.find((id) => steps.get(id)?.kind === "mission") ?? null;

const stationData = Object.fromEntries(
  order.map((id) => {
    const st = stations.get(id)!;
    const step = steps.get(id);
    return [
      id,
      {
        title: step?.title ?? id,
        kind: KIND_LABEL[step?.kind ?? "other"] ?? "기타",
        summary: step?.summary ?? "",
        url: step?.official_url ?? null,
        lines: [...st.lines].sort((a, b) => a - b),
        notes: st.notes,
      },
    ];
  }),
);

// ---------- the questions (field wording and the learn-style options come from the data) ----------
const LEARN: [LearnStyle, string][] = [
  ["hands", "손으로 빨리"], ["study", "차근차근 공부"], ["institution", "기관에서 실무"], ["school", "학교에서 친구들과"],
];
const pickByStyle: Partial<Record<LearnStyle, string>> = {};
for (const p of paths) if (p.learn_style && !pickByStyle[p.learn_style]) pickByStyle[p.learn_style] = p.id;
const learnOpts = LEARN.filter(([v]) => pickByStyle[v]);
const tryPhrase = field.try_phrase?.trim() || null;

const questions = [
  { id: "exp", key: tryPhrase ? `${tryPhrase} 경험` : "해 본 경험",
    ask: tryPhrase ? `${tryPhrase}, 해 본 적 있어요?` : "이 일, 조금이라도 해 본 적 있어요?",
    opts: [["none", "아직 없어요"], ["some", "조금 해 봤어요"], ["often", "자주 해요"]] },
  { id: "school", key: "학교", ask: "지금 학교는요?", opts: [["in", "다니고 있어요"], ["left", "그만뒀어요"], ["done", "졸업했어요"]] },
  { id: "age", key: "나이", ask: "몇 살이에요?", sub: "나이 조건이 있는 혜택을 거르려고 물어봐요.", skip: true,
    opts: [["14-15", "14~15살"], ["16-17", "16~17살"], ["18-19", "18~19살"], ["20-24", "20~24살"]] },
  { id: "region", key: "사는 곳", ask: "어디 살아요?", sub: "지역마다 받을 수 있는 혜택이 달라서요.", skip: true,
    // Every 시·도 (수도권 first), so regional items such as a 광주 scholarship can match; "all" is not a place to live.
    opts: ["seoul", "gyeonggi", "incheon", ...Object.keys(REGION_LABEL).filter((k) => !["all", "seoul", "gyeonggi", "incheon"].includes(k))]
      .map((k) => [k, REGION_LABEL[k]]) },
  // With fewer than two learning styles in the data there is nothing to choose between, so the question is skipped.
  ...(learnOpts.length >= 2 ? [{ id: "learn", key: "배우는 방식", ask: "어떻게 배우고 싶어요?", opts: learnOpts }] : []),
];
const nQ = questions.length;

// ---------- benefits: verified helps, then 공식 자동 items ----------
type HelpX = Help & { audience?: string };
const fmtDeadline = (d: string | null, closed: boolean) => {
  if (d === "rolling") return "상시";
  if (!d) return "모집일 확인 필요";
  if (closed) return "이번에는 마감";
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(d);
  return m ? `${+m[1]}년 ${+m[2]}월 ${+m[3]}일 마감` : d;
};
const fmtAge = (a?: number, b?: number) =>
  a != null && b != null ? `${a}~${b}살` : a != null ? `${a}살부터` : b != null ? `${b}살까지` : "";
const isPast = (d: string | null) => !!d && /^\d{4}-\d{2}-\d{2}$/.test(d) && d < today;
const perks = (helps as HelpX[])
  .map((h) => {
    const regions = h.regions?.length ? h.regions : ["all"];
    const closed = isPast(h.deadline);
    return {
      id: h.id,
      typeLabel: HELP_LABEL[h.type] ?? "기타",
      title: h.title,
      provider: h.provider,
      url: h.url,
      summary: h.summary,
      steps: (h.step_ids ?? []).filter((s) => inField.has(s)),
      field: (h.field_ids ?? []).includes(field.id),
      regions,
      regionLabel: regions.map((r) => REGION_LABEL[r] ?? r).join(" · "),
      deadline: h.deadline,
      closed,
      deadlineLabel: fmtDeadline(h.deadline, closed),
      ageMin: h.age_min ?? null,
      ageMax: h.age_max ?? null,
      ageLabel: fmtAge(h.age_min, h.age_max),
      audience: h.audience ?? "any",
      costLabel: h.cost ? COST_LABEL[h.cost] ?? h.cost : "",
      sponsored: !!h.sponsored,
    };
  })
  .filter((p) => p.field || p.steps.length)
  // Sponsored items are never ranked first: every list keeps them after the rest.
  .sort((a, b) => Number(a.sponsored) - Number(b.sponsored));

// 공식 자동: collected from an official source, not checked by a person. Always after the verified helps.
const md = (d: string) => `${+d.slice(5, 7)}월 ${+d.slice(8, 10)}일`;
const windowLabel = (w: { s: string; e: string }) => (w.s === w.e ? md(w.s) : `${md(w.s)}~${md(w.e)}`);
const autoPerks = autoGroups()
  .map((g) => {
    const windows = g.windows.filter((w) => w.e >= today);
    const next = windows[0];
    return {
      id: g.id,
      tier: "auto" as const,
      typeLabel: g.source === "qnet" ? "자격시험 접수" : HELP_LABEL[g.type as keyof typeof HELP_LABEL] ?? "기타",
      title: g.title,
      provider: g.provider,
      url: g.url,
      summary: g.summary,
      steps: g.stepIds.filter((s) => inField.has(s)),
      field: false,
      regions: g.regions,
      regionLabel: g.regions.map((r) => REGION_LABEL[r] ?? r).join(" · "),
      deadline: windows.length ? windows[windows.length - 1].e : null,
      closed: !next,
      deadlineLabel: next ? `${windowLabel(next)}${next.k ? ` · ${next.k}` : ""}` : "이번에는 마감",
      ageMin: null,
      ageMax: null,
      ageLabel: "",
      audience: g.audience,
      costLabel: g.costText,
      sponsored: false,
      windows: windows.map((w) => ({ ...w, label: windowLabel(w) })),
      sourceLabel: g.sourceLabel,
      seenLabel: g.seen ? md(g.seen) : "",
      oosOk: g.outOfSchoolOk,
      openAll: g.openToAll,
    };
  })
  .filter((p) => p.steps.length && !p.closed);
const allPerks = [...perks, ...autoPerks];
const hasPerks = allPerks.length > 0;

// Static grouping for the no-JS view: every station in map order, then the whole field, then closed.
const seen = new Set<string>();
const ssrGroups = order
  .map((sid) => {
    const items = allPerks.filter((p) => !p.closed && p.steps.includes(sid) && !seen.has(p.id));
    items.forEach((p) => seen.add(p.id));
    return { sid, title: stationData[sid].title, kind: stationData[sid].kind, color: lines[stationData[sid].lines[0]].color, items };
  })
  .filter((g) => g.items.length);
const ssrField = perks.filter((p) => !p.closed && p.field && !seen.has(p.id));
const ssrClosed = perks.filter((p) => p.closed);
const ssrCount = (sid: string) => allPerks.filter((p) => !p.closed && p.steps.includes(sid)).length;
const stationTitle = (sid: string) => stationData[sid]?.title ?? sid;

const stationViews = order.map((id) => {
  const st = stations.get(id)!;
  const lanes = [...st.lines].sort((a, b) => a - b);
  const transfer = lanes.length > 1;
  const { title, kind } = stationData[id];
  return {
    id, title, kind, transfer,
    o: pos.get(id)!,
    l0: lanes[0],
    l1: lanes[lanes.length - 1],
    color: lines[lanes[0]].color,
    lineIds: lanes.map((i) => lines[i].id).join(" "),
    aria: `${title}, ${kind}${transfer ? `, 환승역, ${lanes.length}개 노선이 지나요` : ""}`,
    count: ssrCount(id),
  };
});

const data = {
  field: { id: field.id, title: field.title, subject: iga(field.title), tryIga: tryPhrase ? iga(tryPhrase) : null },
  qn: KNUM[nQ] ?? String(nQ),
  questions,
  pick: pickByStyle,
  lines: lines.map(({ id, title, color, steps }) => ({ id, title, color, steps })),
  order,
  stations: stationData,
  mission,
  perks: allPerks,
  hasPerks,
  checkingAsOf: CHECKING_AS_OF,
};
const emptyMain = "받을 수 있는 혜택은 공식 출처로 확인하는 대로 여기에 떠요.";
const emptySub = `(${CHECKING_AS_OF} 기준 확인 중)`;
const pageDesc = `${field.summary} 질문 ${KNUM[nQ] ?? nQ} 개에 답하면 먼저 볼 노선을 노선도에서 밝혀 줘요.`;
---
<Site title={`${field.title} 길 지도`} description={pageDesc}>
  <div class="stage">
    <!-- 1. conversation -->
    <main class="talk" id="talk" aria-labelledby="room-title">
      <div class="room">
        <h2 id="room-title">{field.title}, 어디서 시작할까</h2>
        <p>질문 {KNUM[nQ] ?? nQ} 개, 1분이면 돼요. 답은 이 화면에만 남아요.</p>
      </div>
      <ol class="thread" id="thread" aria-live="polite" aria-label="대화"></ol>
      <div class="composer" id="composer" hidden>
        <p class="q"><span id="q-label">답을 골라 주세요</span><span class="dots" id="dots" aria-hidden="true">{questions.map(() => <i></i>)}</span></p>
        <div class="choices" id="choices" role="group" aria-labelledby="q-label"></div>
        <div class="tools">
          <button type="button" class="tool" id="back" hidden>← 이전 질문으로</button>
          <button type="button" class="tool" id="restart" hidden>처음부터 다시</button>
        </div>
        <p class="privacy">고른 답은 저장하거나 보내지 않아요. 새로고침하면 사라져요.</p>
      </div>
    </main>

    <!-- 2. map + benefits -->
    <section class="result" id="result" aria-labelledby="result-title">
      <div class="intro">
        <p class="eyebrow">{field.title} 분야 · 노선 {lines.length}개 · 역 {order.length}개</p>
        <h1 id="result-title" tabindex="-1">{field.title} 길 지도</h1>
        <div class="stripe" aria-hidden="true">{lines.map((l) => <span style={`background:${l.color}`}></span>)}</div>
        <p class="nojs-note">
          대화는 자바스크립트가 켜져 있어야 움직여요. 대신 노선을 모두 그려 두고{hasPerks ? ", 받을 수 있는 혜택도 전부 펼쳐 둘게요" : ""}. 노선 순서는 순위가 아니에요.
        </p>
        <p class="preview-note">
          질문에 답하면 이 지도에서 먼저 볼 노선이 {hasPerks ? "밝혀지고, 옆에 받을 수 있는 혜택이 떠요" : "밝혀져요"}.
        </p>
      </div>

      <div class="result-grid">
        <div class="left">
          <div class="recap" id="recap"></div>
          <section class="legend" aria-labelledby="legend-h">
            <h2 id="legend-h">노선 고르기</h2>
            <p class="legend-note">어느 노선이 더 좋은 건 아니에요. 누르면 그 노선이 또렷해져요{hasPerks ? ". 혜택도 그 노선 기준으로 바뀌어요" : ""}.</p>
            <ul>
              {lineSegs.map((l) => (
                <li>
                  <button class="line-btn" type="button" data-line={l.id} aria-pressed="false" style={`--c:${l.color}`}>
                    <span class="sym" aria-hidden="true"><i></i></span>
                    <span class="lt">
                      <strong>{l.title}</strong>
                      <span class="rec" hidden>이 노선부터 봐도 좋아요</span>
                      <span class="sm">{l.summary}</span>
                    </span>
                    <span class="count">역 {l.steps.length}개</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>

          <section class="board" aria-label="노선도">
            <div class="map" id="map" style={`--n:${order.length};--lanes:${lines.length}`}>
              {lineSegs.map((l) => (
                <span class="ln" data-line={l.id} style={`--l:${l.lane};--a:${l.a};--b:${l.b};--c:${l.color}`} />
              ))}
              {stationViews.map((s) => (
                <button
                  type="button"
                  class:list={["st", { tr: s.transfer }]}
                  data-st={s.id}
                  data-lines={s.lineIds}
                  aria-label={s.count ? `${s.aria}, 혜택 ${s.count}개` : s.aria}
                  aria-controls="perks"
                  style={`--o:${s.o};--l0:${s.l0};--l1:${s.l1};--c:${s.color}`}
                >
                  <span class="leader" aria-hidden="true" />
                  <span class="dot" aria-hidden="true" />
                  <span class="name">
                    <b>{s.title}</b>
                    <small>
                      <span>{s.kind}</span>
                      {s.transfer && <em>환승</em>}
                      <span class="wk" hidden>이번 주에 해 볼 일</span>
                      {hasPerks && <span class="pn" hidden={s.count === 0}>혜택 {s.count}</span>}
                    </small>
                  </span>
                </button>
              ))}
            </div>
            <p class="key" aria-hidden="true">
              <span><i class="k-dot"></i>역</span>
              <span><i class="k-tr"></i>환승역</span>
              {hasPerks && <span><i class="k-pn">혜택 N</i>받을 수 있는 혜택 수</span>}
            </p>
          </section>
        </div>

        <aside class="perks" id="perks" aria-labelledby="perks-kicker" aria-live="polite">
          <div class="perks-head">
            <h2 class="perks-kicker" id="perks-kicker">받을 수 있는 혜택</h2>
            <p class="perks-scope" id="perks-scope" tabindex="-1"><i aria-hidden="true"></i><span>노선 전체</span></p>
            {hasPerks && (
              <div class="count-row">
                <p id="perks-count">전체 <b>{allPerks.length}개</b></p>
                <label class="all-toggle"><input type="checkbox" id="all-toggle" /> 조건 없이 모두 보기</label>
              </div>
            )}
          </div>
          <div class="perks-body" id="perks-body">
            {!hasPerks && (
              <div class="perks-empty">
                <p>{emptyMain}</p>
                <p class="quiet">{emptySub}</p>
              </div>
            )}
            {ssrGroups.map((g) => (
              <section class="pg" style={`--c:${g.color}`}>
                <h3 class="pg-h"><i class="pg-dot" aria-hidden="true"></i>{g.title}<small>{g.kind}</small></h3>
                <ol class="plist">
                  {g.items.map((p) => <PerkCard p={p} stationTitle={stationTitle} />)}
                </ol>
              </section>
            ))}
            {ssrField.length > 0 && (
              <section class="pg field">
                <h3 class="pg-h"><i class="pg-dot" aria-hidden="true"></i>{field.title} 분야 전체</h3>
                <ol class="plist">
                  {ssrField.map((p) => <PerkCard p={p} />)}
                </ol>
              </section>
            )}
            {ssrClosed.length > 0 && (
              <details class="closed">
                <summary>이번에는 마감됐어요 · {ssrClosed.length}개</summary>
                <ol class="plist">
                  {ssrClosed.map((p) => <PerkCard p={p} />)}
                </ol>
              </details>
            )}
          </div>
          <p class="perks-foot">
            혜택은 광고를 받고 고르지 않아요. 후원을 받은 것은 ‘후원’ 표시를 붙이고 앞자리에 두지 않아요. 순서는 노선의 역 순서를 따라요.
            {autoPerks.length > 0 && " ‘공식 자동’은 기관의 공식 자료에서 자동으로 모은 것이라 사람이 아직 확인하지 않았어요. 사람이 확인한 혜택 뒤에 둬요."}
          </p>
        </aside>
      </div>
    </section>
  </div>

  <script type="application/json" id="field-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>

  <script is:inline>
    (() => {
      const D = JSON.parse(document.getElementById("field-data").textContent);
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
      const $ = (id) => document.getElementById(id);
      const L = Object.fromEntries(D.lines.map((l) => [l.id, l]));
      const ST = D.stations;
      const Q = D.questions;
      const N = Q.length;
      const QI = Object.fromEntries(Q.map((q, i) => [q.id, i]));
      const AGE = { "14-15": [14, 15], "16-17": [16, 17], "18-19": [18, 19], "20-24": [20, 24] };
      const label = (qi, v) => (v === "skip" ? "건너뛰기" : Q[qi].opts.find((o) => o[0] === v)[1]);
      const batchim = (w) => { const c = w.charCodeAt(w.length - 1); return c >= 0xac00 && c <= 0xd7a3 && (c - 0xac00) % 28 !== 0; };

      // Deadlines are re-checked against today's date so a stale build never shows a passed deadline as open.
      const pad = (n) => String(n).padStart(2, "0");
      const now = new Date();
      const todayIso = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      D.perks.forEach((p) => {
        if (/^\d{4}-\d{2}-\d{2}$/.test(p.deadline || "") && p.deadline < todayIso && !p.closed) {
          p.closed = true;
          p.deadlineLabel = "이번에는 마감";
        }
      });
      // 공식 자동 items keep only the windows still open or ahead; one with none left is not shown at all.
      D.perks = D.perks.filter((p) => {
        if (p.tier !== "auto") return true;
        p.windows = p.windows.filter((w) => w.e >= todayIso);
        return p.windows.length > 0;
      });
      D.hasPerks = D.perks.length > 0;
      const daysTo = (d) => Math.round((Date.parse(d) - Date.parse(todayIso)) / 864e5);

      const blank = () => Array(N).fill(null);
      let S = { a: blank(), done: false, line: null, rec: null, station: null, all: false, undo: null };
      let shown = 0, token = 0, fast = false;
      const ans = (id) => (id in QI ? S.a[QI[id]] : null);

      const bot = (html, cls = "") => ({ from: "bot", html, cls });
      const me = (html) => ({ from: "me", html });
      const askHtml = (i) => esc(Q[i].ask) + (Q[i].sub ? `<span class="sub">${esc(Q[i].sub)}</span>` : "");
      const nextQ = () => S.a.findIndex((v) => v == null);

      function react(i, v) {
        const id = Q[i].id;
        if (i === N - 1) return "좋아요, 다 됐어요. 노선도를 펼쳐 볼게요.";
        if (id === "exp") return v === "none" ? "괜찮아요, 다들 처음은 있어요." : v === "some" ? "오, 시작은 했네요." : "좋아요, 손에 익은 게 있겠네요.";
        if (id === "school") {
          if (v === "left") return D.hasPerks ? "알려 줘서 고마워요. 그만둔 뒤에 받을 수 있는 혜택도 꽤 있어요." : "알려 줘서 고마워요. 학교를 그만둬도 갈 수 있는 길이 여럿이에요.";
          return v === "in" && D.hasPerks ? "알겠어요. 재학생만 받는 혜택도 챙겨 볼게요." : "알겠어요.";
        }
        if (id === "age") return v === "skip" ? "괜찮아요, 몰라도 찾아볼 수 있어요." : "알겠어요.";
        if (id === "region") {
          if (v === "skip") return D.hasPerks ? "괜찮아요. 전국 어디서나 받는 혜택도 많아요." : "괜찮아요.";
          return v === "other" ? "그럼 전국 어디서나 받을 수 있는 혜택 위주로 볼게요." : `좋아요, ${esc(label(i, v))} 기준으로 찾아볼게요.`;
        }
        return "알겠어요.";
      }

      function messages() {
        const intro = QI.learn != null
          ? `먼저 볼 만한 노선${D.hasPerks ? "과 받을 수 있는 혜택을 같이" : "을"} 보여 줄게요.`
          : `노선도${D.hasPerks ? "와 받을 수 있는 혜택을 같이" : "를"} 보여 줄게요.`;
        const out = [
          bot(`안녕하세요! ${esc(D.field.subject)} 되는 길은 여러 개예요. ${esc(D.qn)} 가지만 물어보고, ${intro}`),
          bot(askHtml(0)),
        ];
        for (let i = 0; i < N; i++) {
          const v = S.a[i];
          if (v == null) return out;
          out.push(me(v === "skip" ? "건너뛸게요" : esc(label(i, v))));
          out.push(bot(react(i, v)));
          if (i < N - 1) out.push(bot(askHtml(i + 1)));
        }
        return out;
      }

      const thread = $("thread"), composer = $("composer"), choices = $("choices");
      const qLabel = $("q-label"), dots = $("dots").children, backBtn = $("back"), restartBtn = $("restart");
      const result = $("result");
      const allToggle = $("all-toggle");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const mobile = matchMedia("(max-width: 899px)");
      composer.hidden = false;
      result.inert = true;

      function rowEl(msg, prev, isNew) {
        const li = document.createElement("li");
        const first = msg.from === "bot" && (!prev || prev.from !== "bot");
        li.className = `row ${msg.from}${first ? " first" : ""}${isNew ? " new" : ""}`;
        li.innerHTML = msg.from === "bot"
          ? `<span class="face" aria-hidden="true">선배</span><div class="col"><span class="name">길잡이 선배</span><div class="b ${msg.cls}">${msg.html}</div></div>`
          : `<div class="b">${msg.html}</div>`;
        return li;
      }

      function choiceBtn(text, cls, fn) {
        const b = document.createElement("button");
        b.type = "button"; b.className = cls; b.textContent = text;
        b.addEventListener("click", fn);
        choices.append(b);
        return b;
      }

      function setChoices() {
        const qi = nextQ();
        choices.innerHTML = "";
        choices.className = "choices";
        [...dots].forEach((d, i) => { d.className = i === qi ? "now" : S.a[i] != null ? "on" : ""; });
        if (qi < 0) {
          qLabel.textContent = "노선도를 펼치는 중이에요";
          backBtn.hidden = restartBtn.hidden = true;
          return;
        }
        qLabel.textContent = `${qi + 1} / ${N} · ${Q[qi].ask}`;
        if (Q[qi].opts.length > 6) choices.classList.add("three");
        else if (Q[qi].opts.length >= 4 && Q[qi].opts.length % 2 === 0) choices.classList.add("two");
        Q[qi].opts.forEach(([v, t]) => choiceBtn(t, "choice", () => answer(qi, v)));
        if (Q[qi].skip) choiceBtn("건너뛰기", "choice ghost", () => answer(qi, "skip"));
        if (S.undo && S.undo.i === qi) choiceBtn("그대로 둘게요", "choice ghost", () => answer(qi, S.undo.v));
        backBtn.hidden = qi === 0;
        restartBtn.hidden = S.a.every((v) => v == null);
        thread.style.setProperty("--ch", `${composer.offsetHeight + 12}px`);
        thread.lastElementChild?.scrollIntoView({ block: "nearest" });
      }

      function answer(qi, v) {
        const editing = !!S.undo;
        S.a = S.a.map((x, i) => (i === qi ? v : x));
        if (editing && nextQ() < 0) fast = true;
        S.undo = null;
        update();
      }

      function update() {
        const my = ++token;
        const msgs = messages();
        const keep = Math.min(shown, msgs.length);
        thread.innerHTML = "";
        msgs.slice(0, keep).forEach((m, i) => thread.append(rowEl(m, msgs[i - 1], false)));
        shown = keep;
        choices.innerHTML = "";
        const rest = msgs.slice(keep);
        const done = () => {
          setChoices();
          if (nextQ() < 0) {
            const wait = fast ? 120 : 700;
            fast = false;
            setTimeout(() => { if (my === token) enterResult(); }, wait);
            return;
          }
          const first = choices.querySelector("button");
          if (first && keep > 0) first.focus({ preventScroll: true });
        };
        if (!rest.length || reduce || fast) {
          rest.forEach((m, i) => thread.append(rowEl(m, msgs[keep + i - 1], false)));
          shown = msgs.length;
          done();
          if (rest.length) thread.lastElementChild.scrollIntoView({ block: "nearest" });
          return;
        }
        let i = 0;
        const next = () => {
          if (my !== token) return;
          const m = rest[i], idx = keep + i;
          if (m.from === "bot") {
            const t = document.createElement("li");
            t.className = "row bot" + (msgs[idx - 1]?.from === "bot" ? "" : " first");
            t.innerHTML = `<span class="face" aria-hidden="true">선배</span><div class="col"><span class="name">길잡이 선배</span><div class="b" aria-label="입력 중"><span class="typing"><i></i><i></i><i></i></span></div></div>`;
            thread.append(t);
            t.scrollIntoView({ block: "nearest" });
            setTimeout(() => {
              if (my !== token) return;
              t.replaceWith(rowEl(m, msgs[idx - 1], true));
              step();
            }, i === 0 ? 340 : 240);
          } else {
            thread.append(rowEl(m, msgs[idx - 1], true));
            step();
          }
        };
        const step = () => {
          i++; shown = keep + i;
          thread.lastElementChild?.scrollIntoView({ block: "nearest" });
          if (i < rest.length) next(); else done();
        };
        next();
      }

      function restart() {
        S = { a: blank(), done: false, line: null, rec: null, station: null, all: false, undo: null };
        if (allToggle) allToggle.checked = false;
        leaveResult();
        shown = 2;
        update();
        scrollTo({ top: 0 });
        choices.querySelector("button")?.focus({ preventScroll: true });
      }

      backBtn.addEventListener("click", () => {
        const qi = nextQ();
        if (qi <= 0) return;
        S.a = S.a.map((x, i) => (i === qi - 1 ? null : x));
        S.undo = null;
        shown = messages().length;
        update();
      });
      restartBtn.addEventListener("click", restart);

      // ---------- result: map + benefits ----------
      function leaveResult() {
        S.done = false;
        document.body.classList.remove("done");
        result.inert = true;
      }

      function enterResult() {
        S.done = true;
        const learn = ans("learn");
        S.rec = learn ? D.pick[learn] ?? null : null;
        S.line = S.rec;
        S.station = null;
        document.body.classList.add("done");
        result.inert = false;
        renderAll();
        scrollTo({ top: 0 });
        $("result-title").focus({ preventScroll: true });
      }

      function editAnswer(i) {
        S.undo = { i, v: S.a[i] };
        S.a = S.a.map((x, j) => (j === i ? null : x));
        leaveResult();
        shown = messages().length;
        update();
        requestAnimationFrame(() => composer.scrollIntoView({ block: "end" }));
      }

      // filter by the answers
      function passes(p) {
        if (S.all) return true;
        const school = ans("school"), age = ans("age"), region = ans("region");
        if (region && region !== "skip") {
          const ok = p.regions.includes("all") || (region !== "other" && p.regions.includes(region));
          if (!ok) return false;
        }
        if (age && age !== "skip") {
          const [lo, hi] = AGE[age];
          if ((p.ageMin ?? 0) > hi || (p.ageMax ?? 200) < lo) return false;
        }
        if (p.audience === "out_of_school" && school !== "left") return false;
        if (p.audience === "in_school" && school !== "in") return false;
        return true;
      }
      const at = (sid) => D.perks.filter((p) => p.steps.includes(sid));
      const botRow = (inner, first) =>
        `<li class="row bot${first ? " first" : ""}"><span class="face" aria-hidden="true">선배</span><div class="col">${first ? `<span class="name">길잡이 선배</span>` : ""}${inner}</div></li>`;

      function renderRecap() {
        const a = S.a, rec = S.rec ? L[S.rec] : null;
        const where = mobile.matches ? "노선도 아래에" : "노선도 옆에";
        let h = `<ol class="thread" aria-label="대화 요약">`;
        if (rec) {
          const how = label(QI.learn, ans("learn"));
          h += botRow(`<div class="b pathhead" style="--c:${rec.color}"><span class="label">이 노선부터 봐도 좋아요</span><span class="t">${esc(rec.title)}</span>` +
            `‘${esc(Q[QI.learn].ask)}’에 <strong>${esc(how)}</strong>${batchim(how) ? "이라고" : "라고"} 해서 먼저 밝혀 뒀어요. 다른 노선이 틀린 건 아니에요. 아래에서 바꿔 볼 수 있어요.</div>`, true);
        } else {
          h += botRow(`<div class="b">노선 ${D.lines.length}개를 모두 똑같이 그려 뒀어요. 어느 노선이 더 좋은 건 아니에요. 아래에서 하나를 누르면 그 노선이 또렷해져요.</div>`, true);
        }
        if (D.mission && ans("exp") === "none") {
          const lead = D.field.tryIga ? `${esc(D.field.tryIga)} 처음이면` : "처음이면";
          h += botRow(`<div class="b mission">${lead}, 노선보다 먼저 이번 주에 <strong>${esc(ST[D.mission].title)}</strong>부터 해 봐요. 노선도에 ‘이번 주에 해 볼 일’로 표시해 뒀어요.<br><button type="button" class="inline-go" data-go="${D.mission}">그 역 보기</button></div>`);
        }
        h += botRow(D.hasPerks
          ? `<div class="b">받을 수 있는 혜택은 답에 맞춰 골라서 ${where} 띄워 뒀어요. 역을 누르면 그 역 혜택이 먼저 나와요.</div>`
          : `<div class="b">받을 수 있는 혜택은 공식 출처로 확인하는 대로 ${where} 띄울게요. 지금은 역을 누르면 그 역이 어떤 곳인지 볼 수 있어요.</div>`);
        h += `</ol>`;
        const summary = a.map((v, i) => (v === "skip" ? `${Q[i].key} 건너뜀` : label(i, v))).join(" · ");
        h += `<div class="answers"><div class="row me"><div class="b"><span class="sr">내 답: </span>${esc(summary)}</div></div><div class="answer-tools">` +
          `<details class="edit"><summary>답 바꾸기</summary><ul>` +
          a.map((v, i) => `<li><button type="button" data-edit="${i}"><span>${esc(Q[i].key)}</span><b>${esc(v === "skip" ? "건너뜀" : label(i, v))}</b><em>바꾸기</em></button></li>`).join("") +
          `</ul></details><button type="button" class="tool" data-act="restart">처음부터 다시</button></div></div>`;
        $("recap").innerHTML = h;
      }

      function applyLine() {
        const id = S.line;
        document.querySelectorAll(".line-btn").forEach((b) => {
          b.setAttribute("aria-pressed", String(b.dataset.line === id));
          b.querySelector(".rec").hidden = b.dataset.line !== S.rec;
        });
        document.querySelectorAll(".ln").forEach((s) => s.classList.toggle("dim", !!id && s.dataset.line !== id));
        document.querySelectorAll(".st").forEach((b) => {
          b.classList.toggle("dim", !!id && !b.dataset.lines.split(" ").includes(id));
          b.classList.toggle("on", b.dataset.st === S.station);
          const isMission = !!D.mission && b.dataset.st === D.mission && ans("exp") === "none";
          b.classList.toggle("mission", isMission);
          b.querySelector(".wk").hidden = !isMission;
        });
      }

      function renderBadges() {
        if (!D.hasPerks) return;
        document.querySelectorAll(".st").forEach((b) => {
          const n = at(b.dataset.st).filter((p) => !p.closed && passes(p)).length;
          const pn = b.querySelector(".pn");
          pn.textContent = `혜택 ${n}`;
          pn.hidden = n === 0;
          const base = b.getAttribute("aria-label").replace(/, 혜택 \d+개$/, "");
          b.setAttribute("aria-label", n ? `${base}, 혜택 ${n}개` : base);
        });
      }

      const titleOf = (sid) => ST[sid]?.title ?? sid;
      // 공식 자동: quieter than a verified card, with the tier, source and date it was collected, and live D-n.
      function autoCard(p) {
        const [w, ...rest] = p.windows;
        const open = w.s <= todayIso;
        const n = daysTo(open ? w.e : w.s);
        const left = open ? (n === 0 ? "오늘 마감" : `접수 중 · 마감 D-${n}`) : `D-${n} 접수 시작`;
        const meta = [[rest.length ? "다음 접수" : "신청", w.label + (w.k ? ` · ${w.k}` : "")], ["남은 날", left], ["지역", p.regionLabel], ["금액", p.costLabel]]
          .filter(([, v]) => v).map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v)}</dd></div>`).join("");
        const more = rest.length
          ? `<details class="p-more"><summary>다음 회차 ${rest.length}개 더</summary><ol>${rest.map((r) => `<li><span>${esc(r.label)}</span>${r.k ? `<span>${esc(r.k)}</span>` : ""}</li>`).join("")}</ol></details>`
          : "";
        const hint = p.openAll ? `<p class="p-hint">나이·학력 제한 없이 누구나 신청할 수 있어요.</p>`
          : p.oosOk && ans("school") === "left" ? `<p class="p-hint">학교 밖 청소년도 신청할 수 있다고 적혀 있어요.</p>` : "";
        return `<li class="perk auto">` +
          `<p class="p-tier"><span class="t-auto">공식 자동</span><span>출처 ${esc(p.sourceLabel)}</span>${p.seenLabel ? `<span>${esc(p.seenLabel)} 확인</span>` : ""}</p>` +
          `<p class="p-top"><span class="p-type">${esc(p.typeLabel)}</span></p>` +
          `<h4 class="p-title">${esc(p.title)}</h4><p class="p-prov">${esc(p.provider)}</p>` +
          (p.summary ? `<p class="p-sum">${esc(p.summary)}</p>` : "") +
          `<dl class="p-meta">${meta}</dl>${more}${hint}` +
          `<p class="p-check">기관 원문에서 한 번 더 확인하세요.</p>` +
          `<a class="p-link" href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.sourceLabel)} 원문<span class="sr"> · ${esc(p.title)}</span></a></li>`;
      }
      function card(p) {
        if (p.tier === "auto") return autoCard(p);
        const meta = [["지역", p.regionLabel], ["신청", p.deadlineLabel], ["나이", p.ageLabel], ["비용", p.costLabel]]
          .filter(([, v]) => v).map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v)}</dd></div>`).join("");
        return `<li class="perk${p.closed ? " is-closed" : ""}${p.sponsored ? " is-sponsored" : ""}">` +
          `<p class="p-top"><span class="p-type">${esc(p.typeLabel)}</span>${p.sponsored ? `<span class="p-spon">후원</span>` : ""}</p>` +
          `<h4 class="p-title">${esc(p.title)}</h4><p class="p-prov">${esc(p.provider)}</p><p class="p-sum">${esc(p.summary)}</p>` +
          `<dl class="p-meta">${meta}</dl>` +
          (p.steps.length > 1 ? `<p class="p-at">이어지는 역: ${p.steps.map((s) => esc(titleOf(s))).join(" · ")}</p>` : "") +
          `<a class="p-link" href="${esc(p.url)}" target="_blank" rel="noopener">공식 안내<span class="sr"> · ${esc(p.title)}</span></a></li>`;
      }
      const group = (title, small, color, items, cls = "", empty = "조건에 맞는 혜택은 아직 못 찾았어요.") =>
        `<section class="pg ${cls}"${color ? ` style="--c:${color}"` : ""}><h3 class="pg-h"><i class="pg-dot" aria-hidden="true"></i>${esc(title)}${small ? `<small>${esc(small)}</small>` : ""}</h3>` +
        (items.length ? `<ol class="plist">${items.map(card).join("")}</ol>` : `<p class="pg-empty">${empty}</p>`) + `</section>`;
      const emptyState = () =>
        `<div class="perks-empty"><p>받을 수 있는 혜택은 공식 출처로 확인하는 대로 여기에 떠요.</p><p class="quiet">(${esc(D.checkingAsOf)} 기준 확인 중)</p></div>`;

      function nb(id, fallback) {
        return id ? `<button type="button" class="nb" data-go="${id}">${esc(titleOf(id))}</button>` : `<span class="nb none">${fallback}</span>`;
      }
      function stationBlock(sid) {
        const st = ST[sid];
        const li = S.line && L[S.line].steps.includes(sid) ? D.lines.findIndex((l) => l.id === S.line) : st.lines[0];
        const line = D.lines[li];
        const i = line.steps.indexOf(sid);
        const note = st.notes[String(li)];
        const isMission = sid === D.mission && ans("exp") === "none";
        let h = `<section class="stn" style="--c:${line.color}">`;
        h += `<p class="kind">${esc(isMission ? "이번 주에 해 볼 일" : st.kind)}${st.lines.length > 1 ? ` · 환승역 · 노선 ${st.lines.length}개` : ""}</p>`;
        h += `<h3 class="stn-title">${esc(st.title)}</h3><p class="stn-sum">${esc(st.summary)}</p>`;
        h += `<p class="sign-line">${esc(line.title)}</p><div class="sign-board">` +
          `<div class="sb prev"><span class="dir">← 앞 역</span>${nb(line.steps[i - 1], "처음 역이에요")}</div>` +
          `<div class="sb cur">${esc(st.title)}</div>` +
          `<div class="sb next"><span class="dir">다음 역 →</span>${nb(line.steps[i + 1], "마지막 역이에요")}</div></div>`;
        if (note) h += `<p class="sign-note">${esc(note)}</p>`;
        if (st.lines.length > 1) {
          h += `<p class="tr-lines">이 역을 지나는 노선 ${st.lines.map((k) => `<i style="--c:${D.lines[k].color}" title="${esc(D.lines[k].title)}"></i>`).join("")}</p>`;
        }
        h += `<p class="stn-links">`;
        if (st.url) h += `<a href="${esc(st.url)}" target="_blank" rel="noopener">이 역 공식 안내</a>`;
        const back = D.hasPerks ? (S.line ? "노선 전체 혜택 보기" : "모든 역 혜택 보기") : "역 안내 닫기";
        h += `<button type="button" data-act="line-view">${back}</button>`;
        h += `<button type="button" class="to-map" data-act="to-map" data-st="${sid}">← 노선도로</button></p></section>`;
        return h;
      }

      function renderPanel() {
        const line = S.line ? L[S.line] : null;
        const sids = line ? line.steps : D.order;
        const color = line ? line.color : null;

        const scopeEl = $("perks-scope");
        scopeEl.style.setProperty("--c", S.station ? L[S.line]?.color ?? D.lines[ST[S.station].lines[0]].color : color ?? "var(--ink)");
        scopeEl.querySelector("span").textContent = S.station
          ? `${titleOf(S.station)} 역부터`
          : line ? `‘${line.title}’ 노선` : "모든 노선";

        if (!D.hasPerks) {
          $("perks-body").innerHTML = (S.station ? stationBlock(S.station) : "") + emptyState();
          return;
        }

        const scope = new Set();
        if (S.station) at(S.station).forEach((p) => scope.add(p));
        sids.forEach((sid) => at(sid).forEach((p) => scope.add(p)));
        D.perks.filter((p) => p.field).forEach((p) => scope.add(p));
        // Keep the data order (sponsored last) whatever order the stations added them in.
        const all = D.perks.filter((p) => scope.has(p));
        const open = all.filter((p) => !p.closed && passes(p));
        const closed = all.filter((p) => p.closed && passes(p));

        $("perks-count").innerHTML = S.all
          ? `조건 없이 보는 중 · 전체 <b>${all.length}개</b>`
          : `조건에 맞는 혜택 <b>${open.length}개</b> · 전체 ${all.length}개`;
        allToggle.checked = S.all;

        const used = new Set();
        const take = (list) => list.filter((p) => !p.closed && passes(p) && !used.has(p.id)).map((p) => (used.add(p.id), p));
        let h = "";
        if (S.station) {
          h += stationBlock(S.station);
          h += group("이 역의 혜택", "", null, take(at(S.station)), "here", "이 역에 맞는 혜택은 아직 못 찾았어요. 아래 다른 역도 봐 주세요.");
        }
        sids.filter((sid) => sid !== S.station).forEach((sid) => {
          h += group(titleOf(sid), ST[sid].kind, color ?? D.lines[ST[sid].lines[0]].color, take(at(sid)));
        });
        const fieldItems = take(D.perks.filter((p) => p.field));
        if (fieldItems.length) h += group(`${D.field.title} 분야 전체`, "어느 노선이든", null, fieldItems, "field");
        if (closed.length) {
          h += `<details class="closed"><summary>이번에는 마감됐어요 · ${closed.length}개</summary><ol class="plist">${closed.map(card).join("")}</ol></details>`;
        }
        $("perks-body").innerHTML = h;
      }

      function renderAll() {
        renderRecap();
        applyLine();
        renderBadges();
        renderPanel();
      }

      function openStation(sid, fromMap) {
        if (!ST[sid]) return;
        S.station = sid;
        applyLine();
        renderPanel();
        const perks = $("perks");
        if (mobile.matches) {
          perks.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
          $("perks-scope").focus({ preventScroll: true });
        } else {
          perks.scrollTop = 0;
          if (!fromMap) $("perks-scope").focus({ preventScroll: true });
        }
      }

      document.querySelectorAll(".line-btn").forEach((b) =>
        b.addEventListener("click", () => {
          S.line = b.getAttribute("aria-pressed") === "true" ? null : b.dataset.line;
          S.station = null;
          applyLine();
          renderPanel();
        }),
      );
      document.querySelectorAll(".st").forEach((b) => b.addEventListener("click", () => openStation(b.dataset.st, true)));
      allToggle?.addEventListener("change", (e) => {
        S.all = e.target.checked;
        renderBadges();
        renderPanel();
      });
      result.addEventListener("click", (e) => {
        const go = e.target.closest("[data-go]");
        if (go) return openStation(go.dataset.go, false);
        const ed = e.target.closest("[data-edit]");
        if (ed) return editAnswer(+ed.dataset.edit);
        const act = e.target.closest("[data-act]");
        if (!act) return;
        if (act.dataset.act === "restart") restart();
        if (act.dataset.act === "line-view") { S.station = null; applyLine(); renderPanel(); $("perks-scope").focus({ preventScroll: true }); }
        if (act.dataset.act === "to-map") {
          const st = document.querySelector(`.st[data-st="${act.dataset.st}"]`);
          st?.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "center" });
          st?.focus({ preventScroll: true });
        }
      });
      mobile.addEventListener("change", () => { if (S.done) renderRecap(); });

      update();
    })();
  </script>
</Site>

