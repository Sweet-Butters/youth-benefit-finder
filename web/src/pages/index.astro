---
// Home (D22): the guide's first words, a small preview of the first 노선도 starting from "지금 여기",
// one clear way in, a four-row legend and the latest reading. Everything is computed from the data.
import { getCollection } from "astro:content";
import Site from "../layouts/Site.astro";
import { fields, steps } from "../lib/content";

const live = fields.filter((f) => !f.retired);
const first = live[0];
const LINE = ["var(--line-1)", "var(--line-2)", "var(--line-3)", "var(--line-4)"];
const posts = (await getCollection("guide", (p) => import.meta.env.DEV || !p.data.draft))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 3);

const fieldStats = (f: (typeof fields)[number]) => {
  const ps = f.paths.filter((p) => !p.retired);
  return { paths: ps, stationCount: new Set(ps.flatMap((p) => p.steps.map((s) => s.step))).size };
};

// ---------- mini map for the first field: every line leaves from "지금 여기" ----------
type MiniStation = { id: string; title: string; col: number; lanes: number[] };
let mini: null | {
  w: number; h: number; laneY: number[]; colX: (c: number) => number;
  lines: { color: string; x2: number; y: number }[]; stations: MiniStation[]; transfers: MiniStation[];
} = null;
if (first) {
  const ps = fieldStats(first).paths;
  // column = longest chain of steps before it, so shared steps line up across lines
  const col = new Map<string, number>();
  for (let pass = 0; pass < 8; pass++)
    ps.forEach((p) => p.steps.forEach((s, i) => {
      const c = i === 0 ? 1 : (col.get(p.steps[i - 1].step) ?? 1) + 1;
      if (c > (col.get(s.step) ?? 0)) col.set(s.step, c);
    }));
  const lanesOf = new Map<string, number[]>();
  ps.forEach((p, li) => p.steps.forEach((s) => lanesOf.set(s.step, [...(lanesOf.get(s.step) ?? []), li])));
  const cols = Math.max(...col.values());
  const w = 360, top = 58, gap = 22, left = 34, right = 30;
  const laneY = ps.map((_, i) => top + i * gap);
  const colX = (c: number) => left + (c * (w - left - right)) / cols;
  const stations: MiniStation[] = [...col.entries()].map(([id, c]) => ({
    id, title: steps.get(id)?.title ?? id, col: c, lanes: [...new Set(lanesOf.get(id))].sort(),
  }));
  mini = {
    w, h: laneY[laneY.length - 1] + 70, laneY, colX,
    lines: ps.map((p, i) => ({
      color: LINE[i % LINE.length], y: laneY[i],
      x2: colX(Math.max(...p.steps.map((s) => col.get(s.step)!))),
    })),
    stations,
    transfers: stations.filter((s) => s.lanes.length > 1),
  };
}
const firstStats = first ? fieldStats(first) : null;
const fmt = (d: Date) => d.toISOString().slice(0, 10).replaceAll("-", ".");
---
<Site title="처음" description="학교에 다니든 그만뒀든, 지금 있는 자리에서 갈 수 있는 길을 지하철 노선도처럼 보여 줘요. 가입 없이 볼 수 있어요.">
  <main class="home">
    <section class="hero" aria-labelledby="hero-h">
      <div class="hero-text">
        <p class="eyebrow">학교에 다니든, 그만뒀든</p>
        <h1 id="hero-h" class="display">지금 내 자리에서<br />시작하는 진로</h1>

        <ol class="talk" aria-label="길잡이의 말">
          <li class="row first">
            <span class="face" aria-hidden="true">길잡이</span>
            <p class="b">어디서 시작해도 갈 수 있는 길이 있어요. 지금 있는 자리를 <strong>첫 역</strong>으로 삼으면 돼요.</p>
          </li>
          <li class="row">
            <span class="face" aria-hidden="true"></span>
            <p class="b">대학도 여러 길 중 하나예요. 노선마다 무엇을 하면 되는지 역 순서대로 보여 줄게요.</p>
          </li>
        </ol>
      </div>

      {first && mini && firstStats && (
        <div class="preview">
          <figure class="board">
            <figcaption class="board-head">
              <span class="display">{first.title} 노선도</span>
              <span class="board-meta">노선 {firstStats.paths.length}개 · 역 {firstStats.stationCount}개</span>
            </figcaption>
            <svg viewBox={`0 0 ${mini.w} ${mini.h}`} role="img" aria-label={`${first.title} 노선도 미리 보기. 노선 ${firstStats.paths.length}개가 모두 지금 여기에서 출발해요.${mini.transfers.map((t) => ` ${t.title}은 환승역이에요.`).join("")}`}>
              {/* you-are-here flag */}
              <g class="here">
                <rect x="6" y="6" width="74" height="26" rx="2" />
                <path d={`M 26 32 L 34 40 L 42 32 Z`} />
                <text x="43" y="24" text-anchor="middle">지금 여기</text>
              </g>
              {mini.lines.map((l) => (
                <line x1={mini!.colX(0)} x2={l.x2} y1={l.y} y2={l.y} stroke={l.color} stroke-width="6" stroke-linecap="round" />
              ))}
              {/* start capsule spans every line */}
              <rect class="start" x={mini.colX(0) - 11} y={mini.laneY[0] - 11} width="22" height={mini.laneY[mini.laneY.length - 1] - mini.laneY[0] + 22} rx="11" />
              {mini.stations.map((s) => {
                const x = mini!.colX(s.col);
                if (s.lanes.length > 1) {
                  const y0 = mini!.laneY[s.lanes[0]], y1 = mini!.laneY[s.lanes[s.lanes.length - 1]];
                  return <rect class="tr" x={x - 10} y={y0 - 10} width="20" height={y1 - y0 + 20} rx="10" />;
                }
                return <circle class="st" cx={x} cy={mini!.laneY[s.lanes[0]]} r="6.5" stroke={LINE[s.lanes[0] % LINE.length]} />;
              })}
              {mini.transfers.map((t, i) => {
                const x = mini!.colX(t.col);
                const last = i === mini!.transfers.length - 1;
                // alternate labels above and below the lines so neighbouring names never collide; the last sits below
                const below = (mini!.transfers.length - 1 - i) % 2 === 0;
                const y = below ? mini!.laneY[mini!.laneY.length - 1] + 34 : 20;
                return (
                  <g class="lab">
                    {below ? <line x1={x} x2={x} y1={y - 22} y2={y - 14} /> : <line x1={x} x2={x} y1={y + 21} y2={y + 27} />}
                    <text x={last ? x + 12 : x} y={y} text-anchor={last ? "end" : "middle"}>{t.title}</text>
                    <text class="sub" x={last ? x + 12 : x} y={y + 17} text-anchor={last ? "end" : "middle"}>환승역</text>
                  </g>
                );
              })}
            </svg>
          </figure>

          <a class="go" href={`/fields/${first.id}`}>
            <span class="go-t">
              <small>노선 {firstStats.paths.length}개를 나란히 봐요</small>
              <b>{first.title} 노선도 보기</b>
            </span>
            <span class="go-arrow" aria-hidden="true">→</span>
          </a>
          <p class="free">가입 없이 볼 수 있어요 · 3분이면 봐요</p>
        </div>
      )}
    </section>

    <section class="legend" aria-labelledby="legend-h">
      <h2 id="legend-h" class="display">이렇게 봐요</h2>
      <ol>
        <li>
          <svg viewBox="0 0 48 20" aria-hidden="true"><line x1="4" x2="44" y1="10" y2="10" stroke="var(--line-2)" stroke-width="6" stroke-linecap="round" /></svg>
          <p><b>노선</b>은 길이에요. 한 분야에 노선이 여러 개 있어요.</p>
        </li>
        <li>
          <svg viewBox="0 0 48 20" aria-hidden="true"><line x1="4" x2="44" y1="10" y2="10" stroke="var(--line-1)" stroke-width="6" stroke-linecap="round" /><circle cx="24" cy="10" r="7" fill="#fff" stroke="var(--line-1)" stroke-width="3.5" /></svg>
          <p><b>역</b>은 할 일이에요. 시험, 자격증, 훈련, 체험 같은 거요.</p>
        </li>
        <li>
          <svg viewBox="0 0 48 32" aria-hidden="true"><line x1="4" x2="44" y1="9" y2="9" stroke="var(--line-3)" stroke-width="6" stroke-linecap="round" /><line x1="4" x2="44" y1="23" y2="23" stroke="var(--line-4)" stroke-width="6" stroke-linecap="round" /><rect x="15" y="1" width="18" height="30" rx="9" fill="#fff" stroke="var(--ink)" stroke-width="3.5" /></svg>
          <p><b>환승역</b>은 여러 길이 만나는 곳이에요. 여기서 다른 노선으로 갈아탈 수 있어요.</p>
        </li>
        <li>
          <svg viewBox="0 0 48 24" aria-hidden="true"><circle cx="12" cy="12" r="7" fill="#fff" stroke="var(--ink-2)" stroke-width="3.5" /><rect x="24" y="4" width="22" height="16" rx="2" fill="var(--carrot)" /><text x="35" y="16.5" text-anchor="middle" fill="#fff" font-size="12" font-weight="700" font-family="var(--ui)">2</text></svg>
          <p><b>혜택</b>은 역 옆에 붙어요. 그 역에서 받을 수 있는 지원, 장학금, 체험이에요.</p>
        </li>
      </ol>
    </section>

    <section class="lines" aria-labelledby="lines-h">
      <h2 id="lines-h" class="display">노선도 고르기</h2>
      <p class="note">어느 노선이 더 좋은 건 아니에요. 지금 내 상황에 맞는 길을 보면 돼요.</p>
      <ul class="field-list">
        {live.map((f) => {
          const s = fieldStats(f);
          return (
            <li class="field">
              <a class="field-head" href={`/fields/${f.id}`}>
                <span class="stripe" aria-hidden="true">{s.paths.map((_, i) => <i style={`background:${LINE[i % LINE.length]}`} />)}</span>
                <span class="fh-t"><b class="display">{f.title}</b><small>노선 {s.paths.length}개 · 역 {s.stationCount}개</small></span>
                <span class="fh-go" aria-hidden="true">→</span>
              </a>
              <ul class="path-list" aria-label={`${f.title} 노선`}>
                {s.paths.map((p, i) => (
                  <li style={`--c:${LINE[i % LINE.length]}`}>
                    <a href={`/fields/${f.id}#${p.id}`}>
                      <span class="sym" aria-hidden="true"></span>
                      <span class="pt"><b>{p.title}</b><span>{p.summary}</span></span>
                      <span class="cnt">역 {p.steps.length}개</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
        <li class="field soon">
          <span class="stripe dashed" aria-hidden="true"></span>
          <span class="fh-t"><b class="display">다음 노선 준비 중</b><small>다른 분야도 하나씩 그리고 있어요. 공식 출처로 확인한 것만 올려요.</small></span>
        </li>
      </ul>
    </section>

    {posts.length > 0 && (
      <section class="reads" aria-labelledby="reads-h">
        <div class="reads-head">
          <h2 id="reads-h" class="display">읽을거리</h2>
          <a href="/guide">전체 보기</a>
        </div>
        <ul>
          {posts.map((p) => (
            <li>
              <a href={`/guide/${p.id}`}>
                <time datetime={p.data.updated.toISOString().slice(0, 10)}>{fmt(p.data.updated)}</time>
                <b>{p.data.title}{p.data.draft && <span class="draft">초안</span>}</b>
                <span>{p.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</Site>

<style>
  .home { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .eyebrow { margin: 0 0 6px; font-size: 15px; font-weight: 600; color: var(--ink-2); }
  h1 { margin: 0; font-size: clamp(38px, 10.5vw, 64px); line-height: 1.08; }
  h2 { margin: 0; font-size: 24px; line-height: 1.3; }

  /* ---------- hero ---------- */
  .hero { padding: 28px 0 8px; }
  .talk { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; max-width: 460px; }
  .row { display: flex; gap: 8px; align-items: flex-start; }
  .face {
    flex: none; width: 40px; height: 40px; border-radius: 14px; background: var(--me); color: var(--me-ink);
    display: grid; place-items: center; font: 600 11px var(--ui); letter-spacing: -0.02em;
  }
  .row:not(.first) .face { visibility: hidden; }
  .b {
    margin: 0; font: 17px/1.6 var(--bubble); padding: 10px 14px; border-radius: 4px 18px 18px 18px;
    background: var(--bubble-bg); box-shadow: 0 1px 0 rgba(27, 31, 42, 0.08);
  }
  .row:not(.first) .b { border-radius: 18px; }
  .b strong { font-weight: 400; background: linear-gradient(transparent 55%, var(--mark) 55%); }

  .preview { margin-top: 26px; }
  .board {
    margin: 0 -16px; background: var(--board); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
    padding: 12px 16px 6px;
  }
  .board-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .board-head .display { font-size: 20px; }
  .board-meta { font-size: 14px; color: var(--ink-2); }
  .board svg { display: block; width: 100%; height: auto; margin-top: 4px; font-family: var(--ui); }
  .here rect, .here path { fill: var(--ink); }
  .here text { fill: #fff; font-size: 13px; font-weight: 700; }
  .start { fill: var(--ink); stroke: #fff; stroke-width: 3; }
  .tr { fill: #fff; stroke: var(--ink); stroke-width: 3.5; }
  .st { fill: #fff; stroke-width: 3.5; }
  .lab line { stroke: var(--lead); stroke-width: 2; stroke-dasharray: 2 3; }
  .lab text { font-size: 13.5px; font-weight: 700; fill: var(--ink); }
  .lab text.sub { font-size: 12px; font-weight: 500; fill: var(--ink-2); }

  .go {
    display: flex; align-items: stretch; margin-top: 16px; text-decoration: none; background: #fff;
    border: 2px solid var(--ink); border-bottom: 8px solid var(--line-1); min-height: 64px;
  }
  .go-t { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 8px 14px; }
  .go-t small { font-size: 14px; color: var(--ink-2); }
  .go-t b { font: 400 23px/1.25 var(--display); }
  .go-arrow { display: grid; place-items: center; width: 64px; background: var(--ink); color: #fff; font-size: 26px; font-weight: 700; }
  .go:hover .go-t b { text-decoration: underline; text-decoration-color: var(--line-1); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .go:hover .go-arrow { background: #000; }
  .free { margin: 10px 0 0; font-size: 15px; color: var(--ink-2); }

  /* ---------- legend ---------- */
  .legend { margin-top: 48px; }
  .legend ol { list-style: none; margin: 10px 0 0; padding: 0; border-top: 2px solid var(--ink); }
  .legend li { display: grid; grid-template-columns: 52px 1fr; gap: 12px; align-items: center; padding: 12px 2px; border-bottom: 1px solid var(--rule); }
  .legend svg { width: 48px; height: 32px; }
  .legend p { margin: 0; font-size: 16px; line-height: 1.55; }
  .legend b { font-weight: 700; }

  /* ---------- lines ---------- */
  .lines { margin-top: 48px; }
  .note { margin: 4px 0 12px; color: var(--ink-2); }
  .field-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .field { border-bottom: 2px solid var(--ink); }
  .field-head, .soon { display: flex; align-items: center; gap: 14px; padding: 14px 2px; text-decoration: none; }
  .stripe { flex: none; display: flex; flex-direction: column; gap: 3px; width: 44px; }
  .stripe i { height: 5px; border-radius: 3px; }
  .stripe.dashed { height: 6px; background: repeating-linear-gradient(90deg, var(--lead) 0 8px, transparent 8px 14px); }
  .fh-t { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .fh-t b { font-size: 24px; line-height: 1.25; }
  .fh-t small { font-size: 14px; color: var(--ink-2); }
  .fh-go { font-size: 22px; font-weight: 700; }
  .field-head:hover b { text-decoration: underline; text-underline-offset: 5px; }
  .soon b { color: var(--ink-2); font-size: 20px; }
  .path-list { list-style: none; margin: 0 0 10px; padding: 0 0 0 58px; }
  .path-list li { border-top: 1px solid var(--rule); }
  .path-list a { display: grid; grid-template-columns: 26px 1fr auto; gap: 10px; align-items: center; padding: 10px 2px; text-decoration: none; }
  .sym { height: 6px; background: var(--c); border-radius: 3px; }
  .pt { display: flex; flex-direction: column; min-width: 0; }
  .pt b { font-weight: 700; font-size: 16px; line-height: 1.4; }
  .pt span { display: none; color: var(--ink-2); font-size: 15px; line-height: 1.5; }
  .cnt { font-size: 14px; color: var(--ink-2); white-space: nowrap; }
  .path-list a:hover b { text-decoration: underline; text-decoration-color: var(--c); text-decoration-thickness: 3px; text-underline-offset: 3px; }

  /* ---------- reading ---------- */
  .reads { margin-top: 48px; }
  .reads-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .reads-head a { font-size: 15px; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .reads ul { list-style: none; margin: 4px 0 0; padding: 0; border-top: 2px solid var(--ink); }
  .reads li { border-bottom: 1px solid var(--rule); }
  .reads li a { display: flex; flex-direction: column; gap: 2px; padding: 14px 2px; text-decoration: none; }
  .reads time { font-size: 13px; color: var(--ink-2); letter-spacing: 0.02em; }
  .reads b { font-size: 18px; line-height: 1.4; }
  .reads li a > span { color: var(--ink-2); font-size: 15px; }
  .reads li a:hover b { text-decoration: underline; text-underline-offset: 4px; }
  .draft { margin-left: 8px; padding: 0 6px; border: 1.5px solid var(--ink-2); font-size: 12px; font-weight: 600; color: var(--ink-2); vertical-align: 2px; }

  @media (min-width: 900px) {
    .home { padding: 0 40px; }
    .hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: start; padding-top: 56px; }
    .talk { margin-top: 28px; }
    .preview { margin-top: 6px; }
    .board { margin: 0; padding: 16px 22px 10px; border: 2px solid var(--ink); }
    .legend { margin-top: 72px; }
    .legend ol { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--rule); }
    .legend li { grid-template-columns: 1fr; align-content: start; gap: 10px; padding: 16px 20px 18px; border-bottom: 0; border-left: 1px solid var(--rule); }
    .legend li:first-child { border-left: 0; padding-left: 2px; }
    .lines { margin-top: 64px; }
    .path-list { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
    .pt span { display: block; }
    .reads { margin-top: 64px; }
    .reads li a { display: grid; grid-template-columns: 120px 1fr; column-gap: 20px; }
    .reads time { grid-row: span 2; padding-top: 4px; }
  }
</style>
