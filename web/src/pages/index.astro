---
// Home = the find-talk v0 (D27, M1): "뭘 하고 싶은지 몰라도 돼요". One question at a time, like the field page (D22):
// three situation questions (나이, 학교, 사는 곳), the interest questions from data/processed/quiz.json, and an optional
// one-line worry. The result shows up to three fields from data/processed/catalog.json and, beside it (under it on
// phones), the benefits board filtered by the situation answers ("내 조건 혜택").
// Privacy: the answers stay in this browser (localStorage, versioned by quiz.version); the worry line is never stored
// or sent, it only lives in this tab until reload. Counting (GoatCounter, only when GC_CODE is set) sends two events,
// find-talk/start and find-talk/done, never the answers.
// Without JS: the static version, i.e. the field map, the benefits board and the catalog list.
import Site from "../layouts/Site.astro";
import { url } from "../lib/url";
import { fields, REGION_LABEL } from "../lib/content";
import { boardEntries, stateOn, todayKst, KIND, KIND_COLOR } from "../lib/board";
import { catalog, quiz, maxByType } from "../lib/findtalk";
import { GC_CODE } from "../lib/stats";

const live = fields.filter((f) => !f.retired);
const liveIds = new Set(live.map((f) => f.id));
const firstMap = live[0] ?? null;
const LINE = ["var(--line-1)", "var(--line-2)", "var(--line-3)"];

// A catalog field is "ready" only when its 노선도 really exists; anything else is shown as 준비 중.
const cat = catalog.map((f) => ({
  id: f.id, title: f.title, holland: f.holland, oneLine: f.one_line, tryFirst: f.try_first ?? "",
  jobs: f.jobs ?? [], words: f.benefit_words ?? [],
  ready: f.status === "ready" && liveIds.has(f.id),
  href: f.status === "ready" && liveIds.has(f.id) ? url(`/fields/${f.id}`) : "",
}));

// ---------- the steps: situation, interest, worry ----------
const REGIONS = ["seoul", "gyeonggi", "incheon", ...Object.keys(REGION_LABEL).filter((k) => !["all", "seoul", "gyeonggi", "incheon"].includes(k))];
type Step = { id: string; kind: "sit" | "quiz" | "worry"; key: string; ask: string; sub?: string; opts: [string, string][]; score?: Record<string, Record<string, number>> };
const situation: Step[] = [
  { id: "age", kind: "sit", key: "나이", ask: "먼저, 몇 살이에요?", sub: "나이 조건이 있는 혜택을 거르려고 물어봐요.",
    opts: [["14-16", "14~16살"], ["17-19", "17~19살"], ["20-24", "20~24살"]] },
  { id: "school", kind: "sit", key: "학교", ask: "지금 학교는요?", sub: "학교 밖 청소년만 받는 혜택도 있어서요.",
    opts: [["in", "다니고 있어요"], ["left", "그만뒀어요"], ["done", "졸업했어요"]] },
  { id: "region", kind: "sit", key: "사는 곳", ask: "어디 살아요?", sub: "지역마다 받을 수 있는 혜택이 달라서요.",
    opts: REGIONS.map((k) => [k, REGION_LABEL[k]] as [string, string]) },
];
// Single choice only: the quiz has no "multi" question yet, and maxByType treats one as "best two" if it ever does.
const interest: Step[] = (quiz?.questions ?? []).map((q) => ({
  id: `q-${q.id}`, kind: "quiz", key: q.text, ask: q.text, sub: q.hint,
  opts: q.options.map((o) => [o.id, o.label] as [string, string]),
  score: Object.fromEntries(q.options.map((o) => [o.id, o.score as Record<string, number>])),
}));
const worry: Step = { id: "worry", kind: "worry", key: "고민 한 줄", ask: "마지막이에요. 요즘 고민을 한 줄로 적어도 돼요.", sub: "저장하지 않아요. 결과 화면에만 다시 보여 줘요.", opts: [] };
const talkReady = interest.length > 0 && cat.length > 0;
const steps = talkReady ? [...situation, ...interest, worry] : [];

// ---------- 내 조건 혜택: board entries still open, upcoming or 상시 ----------
const today = todayKst();
const entries = boardEntries();
const liveBoard = entries.filter((e) => { const s = stateOn(e, today); return s.live && s.status !== "check"; });
const openNow = entries.filter((e) => stateOn(e, today).status === "open").length;
const board = liveBoard.map((e) => ({
  i: e.id, k: e.kind, t: e.title, p: e.provider, rl: e.regionLabel, r: e.regions,
  w: e.windows.map((w) => [w.s, w.e]), ...(e.always ? { a: 1 } : {}),
  lo: e.ageMin, hi: e.ageMax, ...(e.oosOk ? { ok: 1 } : {}), ...(e.forOutOfSchool ? { oos: 1 } : {}),
  // 고등학생·대학생 대상 장학금 ask for a student; a 학교 밖 reader does not see them unless the source says otherwise.
  ...(e.kind === "scholarship" && /^(고등학생|대학생)\s*대상/.test(e.target) && !e.oosOk ? { stu: 1 } : {}),
  q: `${e.title} ${e.summary}`.toLowerCase(),
  ...(e.fieldIds.length ? { fi: e.fieldIds } : {}),
}));

const data = {
  version: quiz?.version ?? 0,
  steps,
  nQuiz: interest.length,
  max: quiz ? maxByType(quiz) : {},
  cat,
  board,
  kinds: KIND,
  colors: KIND_COLOR,
  regions: REGION_LABEL,
  helps: url("/helps/"),
  counting: !!GC_CODE,
};
---
<Site title="처음" description="뭘 하고 싶은지 몰라도 돼요. 몇 가지만 고르면 해 볼 만한 분야와 지금 조건에 맞는 장학금·지원·봉사·체험을 같이 보여 줘요. 가입 없이, 답은 이 브라우저에만 남아요.">
  <main class="ft">
    <div class="ft-stage" id="stage">
      <div class="ft-left">
        <header class="opening">
          <p class="eyebrow">학교에 다니든, 그만뒀든</p>
          <h1 class="display">뭘 하고 싶은지<br />몰라도 돼요</h1>
          <p class="lead">몇 가지만 고르면 해 볼 만한 분야와, 지금 받을 수 있는 혜택을 같이 찾아 줄게요.</p>
          <p class="nojs-note">찾기 대화는 자바스크립트가 켜져 있어야 움직여요. 대신 바로 갈 수 있는 곳을 아래에 모아 뒀어요.</p>
        </header>

        {talkReady && (
          <section class="talk" id="talk" aria-label="찾기 대화">
            <ol class="thread" id="thread" aria-live="polite" aria-label="대화"></ol>
            <div class="composer" id="composer" hidden>
              <div class="prog" aria-hidden="true"><span class="prog-t" id="prog-t"></span><span class="track"><i id="prog-bar"></i></span></div>
              <p class="q" id="q-label">답을 골라 주세요</p>
              <div class="choices" id="choices" role="group" aria-labelledby="q-label"></div>
              <div class="tools">
                <button type="button" class="tool" id="back" hidden>← 이전 질문</button>
                <button type="button" class="tool" id="skip" hidden>이 질문 건너뛰기</button>
                <button type="button" class="tool" id="restart" hidden>처음부터 다시</button>
              </div>
              <p class="privacy">고른 답은 이 브라우저에만 남아요. 어디로도 보내지 않아요.</p>
            </div>
          </section>
        )}
      </div>

      <aside class="side" aria-labelledby="side-h">
        <h2 id="side-h" class="display">대화 없이 바로 보기</h2>
        {firstMap && (
          <a class="go" href={url(`/fields/${firstMap.id}`)}>
            <span class="go-t"><small>길을 지하철 노선도처럼 그려 뒀어요</small><b>{firstMap.title} 노선도</b></span>
            <span class="go-arrow" aria-hidden="true">→</span>
          </a>
        )}
        <a class="now" href={url("/helps/")}>
          <span>혜택 게시판{openNow > 0 && <> · 지금 신청할 수 있는 <b>{openNow}개</b></>}</span>
          <small>장학금 · 지원 · 봉사 · 체험 · 시험, 마감 가까운 순</small>
        </a>
        {cat.length > 0 && (
          <section class="cat" aria-labelledby="cat-h">
            <h3 id="cat-h">찾기 대화가 보여 주는 분야 {cat.length}개</h3>
            <ul>
              {cat.map((f, i) => (
                <li style={`--c:${LINE[i % LINE.length]}`}>
                  {f.ready
                    ? <a href={f.href}><b>{f.title}</b><span>{f.oneLine}</span><em>노선도 보기 →</em></a>
                    : <div><b>{f.title}</b><span>{f.oneLine}</span><em class="soon">노선도 준비 중{f.tryFirst && ` · 먼저 ${f.tryFirst}`}</em></div>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>

    {talkReady && (
      <section class="result" id="result" aria-labelledby="result-title" hidden>
        <div class="res-grid">
          <div class="res-main">
            <p class="eyebrow">찾기 대화 · 시작점</p>
            <h1 id="result-title" class="display" tabindex="-1">해 볼 만한 분야</h1>
            <div class="rule-lines short" aria-hidden="true"></div>
            <div id="recap"></div>
            <ol class="picks" id="picks" aria-label="분야"></ol>
            <p class="start-note" id="start-note"></p>
            <p class="official">
              검사 결과가 아니라 시작점이에요. 공식 검사는 <a href="https://www.career.go.kr" target="_blank" rel="noopener">커리어넷에서</a> 무료로 할 수 있어요.
            </p>
            <div class="res-tools" id="res-tools"></div>
          </div>

          <aside class="mine" id="mine" aria-labelledby="mine-h">
            <div class="mine-head">
              <h2 id="mine-h" class="display">내 조건 혜택</h2>
              <p class="mine-scope" id="mine-scope"></p>
              <p class="mine-count" id="mine-count"></p>
            </div>
            <ol class="mrows" id="mrows"></ol>
            <p class="mine-empty" id="mine-empty" hidden>조건에 맞는 혜택을 아직 못 찾았어요. 조건 없이 게시판 전체를 봐 주세요.</p>
            <p class="mine-foot"><a id="mine-all" href={url("/helps/")}>전체 보기 →</a><span>모두 기관 공식 자료에서 자동으로 모은 것이에요. 신청 전에 원문 공고를 꼭 확인하세요.</span></p>
          </aside>
        </div>
      </section>
    )}
  </main>

  {talkReady && <script type="application/json" id="ft-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>}

  <script is:inline>
    (() => {
      const node = document.getElementById("ft-data");
      if (!node) return;
      const D = JSON.parse(node.textContent);
      const $ = (id) => document.getElementById(id);
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
      const ST = D.steps, N = ST.length, WI = N - 1;
      const SI = Object.fromEntries(ST.map((s, i) => [s.id, i]));
      const QUIZ = ST.map((s, i) => (s.kind === "quiz" ? i : -1)).filter((i) => i >= 0);
      const AGE = { "14-16": [14, 16], "17-19": [17, 19], "20-24": [20, 24] };
      const H = ["R", "I", "A", "S", "E", "C"];
      const KEY = "ybf:find-talk";
      const batchim = (w) => { const c = w.charCodeAt(w.length - 1); return c >= 0xac00 && c <= 0xd7a3 && (c - 0xac00) % 28 !== 0; };
      const plain = (s) => String(s).replace(/[“”"]/g, "");

      // ---------- storage: answers only, never the worry line ----------
      const valid = (i, v) => v === "skip" || (ST[i].kind === "worry" ? v === "done" : ST[i].opts.some((o) => o[0] === v));
      function load() {
        try {
          const x = JSON.parse(localStorage.getItem(KEY) || "null");
          if (!x || x.v !== D.version || !Array.isArray(x.a) || x.a.length !== N) return null;
          return x.a.every((v, i) => v == null || valid(i, v)) ? x.a : null;
        } catch { return null; }
      }
      const save = () => { try { localStorage.setItem(KEY, JSON.stringify({ v: D.version, a: S.a })); } catch {} };
      const forget = () => { try { localStorage.removeItem(KEY); } catch {} };

      // ---------- counting: two events, no answers ----------
      const sent = {};
      function count(name) {
        if (!D.counting || sent[name]) return;
        sent[name] = true;
        try { const gc = window.goatcounter; if (gc && typeof gc.count === "function") gc.count({ path: name, event: true }); } catch {}
      }

      // ---------- dates are re-judged in the browser so a stale build never shows a passed deadline ----------
      const pad = (n) => String(n).padStart(2, "0");
      const now = new Date();
      const today = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
      const days = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 864e5);
      const md = (d) => `${+d.slice(5, 7)}월 ${+d.slice(8, 10)}일`;
      const board = D.board.map((x) => {
        const w = x.w.filter((v) => v[1] >= today);
        if (w.length) { const open = w.find((v) => v[0] <= today); const win = open || w[0]; return { ...x, st: open ? "open" : "upcoming", date: open ? win[1] : win[0], key: win[1], win }; }
        return x.a ? { ...x, st: "always", date: "", key: "9998" } : null;
      }).filter(Boolean).sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : a.t.localeCompare(b.t, "ko")));

      // ---------- state ----------
      const blank = () => Array(N).fill(null);
      let S = { a: blank(), done: false, undo: null, resume: null };
      let worryText = ""; // memory only
      let shown = 0, token = 0, fast = false;
      const ans = (id) => S.a[SI[id]];
      const nextQ = () => S.a.findIndex((v) => v == null);
      const label = (i, v) => (v === "skip" ? "건너뛰기" : (ST[i].opts.find((o) => o[0] === v) || [, v])[1]);

      const bot = (html, cls = "") => ({ from: "bot", html, cls });
      const me = (html, cls = "") => ({ from: "me", html, cls });
      const askHtml = (i) => esc(ST[i].ask) + (ST[i].sub ? `<span class="sub">${esc(ST[i].sub)}</span>` : "");
      const half = QUIZ[Math.floor(QUIZ.length / 2)];

      function react(i, v) {
        const s = ST[i];
        if (s.id === "age") return v === "skip" ? "괜찮아요, 몰라도 찾아볼 수 있어요." : "알겠어요.";
        if (s.id === "school") return v === "left" ? "알려 줘서 고마워요. 학교 밖 청소년이 받을 수 있는 혜택도 꽤 있어요." : "알겠어요.";
        if (s.id === "region") {
          const where = v === "skip" ? "괜찮아요. 전국 어디서나 받을 수 있는 혜택으로 볼게요." : `좋아요, ${esc(label(i, v))}이랑 전국 혜택을 볼게요.`;
          return `${where} 이제 관심 질문 ${D.nQuiz}개예요. 정답은 없으니까 제일 가까운 걸 골라요.`;
        }
        if (s.kind === "quiz") {
          if (v === "skip" || v === "dunno" || !Object.keys(s.score[v] || {}).length) return "괜찮아요, 몰라도 돼요.";
          if (i === half) return "벌써 반 왔어요.";
          return null;
        }
        if (s.kind === "worry") return (worryText ? "적어 줘서 고마워요. 결과 화면에 그대로 둘게요. 저장하지는 않아요. " : "") + "좋아요, 다 됐어요. 결과를 펼쳐 볼게요.";
        return null;
      }
      function meHtml(i, v) {
        if (ST[i].kind === "worry") return worryText ? esc(worryText) : "안 적고 넘어갈게요";
        return v === "skip" ? "건너뛸게요" : esc(label(i, v));
      }

      function messages() {
        if (S.resume) return [bot("다시 왔네요! 지난번에 하던 대화가 이 브라우저에 남아 있어요. 이어서 할까요?")];
        const out = [bot(`안녕하세요! 지금 상황 세 가지랑 가벼운 관심 질문 ${D.nQuiz}개를 물어볼게요. 고르기만 하면 돼요.`), bot(askHtml(0))];
        for (let i = 0; i < N; i++) {
          const v = S.a[i];
          if (v == null) return out;
          out.push(me(meHtml(i, v), ST[i].kind === "worry" && worryText ? "worry" : ""));
          const r = react(i, v);
          if (r) out.push(bot(r));
          if (i < N - 1) out.push(bot(askHtml(i + 1)));
        }
        return out;
      }

      const thread = $("thread"), composer = $("composer"), choices = $("choices");
      const qLabel = $("q-label"), progT = $("prog-t"), progBar = $("prog-bar");
      const backBtn = $("back"), skipBtn = $("skip"), restartBtn = $("restart");
      const result = $("result");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      composer.hidden = false;

      function rowEl(msg, prev, isNew) {
        const li = document.createElement("li");
        const first = msg.from === "bot" && (!prev || prev.from !== "bot");
        li.className = `row ${msg.from}${first ? " first" : ""}${isNew ? " new" : ""}`;
        li.innerHTML = msg.from === "bot"
          ? `<span class="face" aria-hidden="true">선배</span><div class="col"><span class="name">길잡이 선배</span><div class="b ${msg.cls}">${msg.html}</div></div>`
          : `<div class="b ${msg.cls}">${msg.html}</div>`;
        return li;
      }
      function choiceBtn(text, cls, fn) {
        const b = document.createElement("button");
        b.type = "button"; b.className = cls; b.textContent = text;
        b.addEventListener("click", fn);
        choices.append(b);
        return b;
      }

      function progress(qi) {
        const s = ST[qi];
        const qn = QUIZ.indexOf(qi);
        progT.textContent = s.kind === "sit" ? `상황 ${qi + 1}/3` : s.kind === "quiz" ? `관심 ${qn + 1}/${QUIZ.length}` : "마지막";
        progBar.style.width = `${Math.round((qi / N) * 100)}%`;
      }

      function setChoices() {
        choices.innerHTML = "";
        choices.className = "choices";
        skipBtn.hidden = true;
        if (S.resume) {
          qLabel.textContent = "이어서 할까요?";
          progT.textContent = ""; progBar.style.width = `${Math.round((S.resume.filter((v) => v != null).length / N) * 100)}%`;
          choices.classList.add("two");
          choiceBtn("이어서 할게요", "choice", () => { S.a = S.resume; S.resume = null; fast = true; shown = 0; update(); });
          choiceBtn("처음부터 할게요", "choice", () => { S.resume = null; forget(); shown = 1; update(); });
          backBtn.hidden = restartBtn.hidden = true;
          return;
        }
        const qi = nextQ();
        if (qi < 0) {
          qLabel.textContent = "결과를 펼치는 중이에요";
          progT.textContent = "끝"; progBar.style.width = "100%";
          backBtn.hidden = restartBtn.hidden = true;
          return;
        }
        progress(qi);
        const s = ST[qi];
        qLabel.textContent = s.ask;
        if (s.kind === "worry") {
          choices.classList.add("worry");
          const inp = document.createElement("input");
          inp.type = "text"; inp.id = "worry-in"; inp.maxLength = 80; inp.autocomplete = "off"; inp.spellcheck = false;
          inp.setAttribute("enterkeyhint", "done");
          inp.setAttribute("aria-label", "요즘 고민 한 줄 (저장하지 않아요)");
          inp.placeholder = "요즘 고민을 한 줄로 적어도 돼요 (저장하지 않아요)";
          inp.value = worryText;
          choices.append(inp);
          const ok = () => { worryText = inp.value.trim().slice(0, 80); answer(qi, "done"); };
          inp.addEventListener("keydown", (e) => { if (e.key === "Enter" && !e.isComposing) { e.preventDefault(); ok(); } });
          choiceBtn("이렇게 적을게요", "choice", ok);
          choiceBtn("안 적고 넘어갈게요", "choice ghost", () => { worryText = ""; answer(qi, "done"); });
        } else {
          if (s.opts.length > 6) choices.classList.add("three");
          else if (s.kind === "sit") choices.classList.add("two");
          s.opts.forEach(([v, t]) => choiceBtn(t, "choice", () => answer(qi, v)));
          if (s.kind === "sit") choiceBtn("건너뛰기", "choice ghost", () => answer(qi, "skip"));
          else skipBtn.hidden = false;
        }
        if (S.undo && S.undo.i === qi) choiceBtn("그대로 둘게요", "choice ghost", () => answer(qi, S.undo.v));
        backBtn.hidden = qi === 0;
        restartBtn.hidden = S.a.every((v) => v == null);
        thread.style.setProperty("--ch", `${composer.offsetHeight + 12}px`);
      }

      function answer(qi, v) {
        const editing = !!S.undo;
        if (S.a.every((x) => x == null)) count("find-talk/start");
        S.a = S.a.map((x, i) => (i === qi ? v : x));
        if (editing && nextQ() < 0) fast = true;
        S.undo = null;
        save();
        update();
      }

      function update() {
        const my = ++token;
        const msgs = messages();
        const keep = Math.min(shown, msgs.length);
        thread.innerHTML = "";
        msgs.slice(0, keep).forEach((m, i) => thread.append(rowEl(m, msgs[i - 1], false)));
        shown = keep;
        choices.innerHTML = "";
        const rest = msgs.slice(keep);
        const done = () => {
          setChoices();
          if (!S.resume && nextQ() < 0) {
            const wait = fast ? 120 : 700;
            fast = false;
            setTimeout(() => { if (my === token) enterResult(true); }, wait);
            return;
          }
          fast = false;
          thread.lastElementChild?.scrollIntoView({ block: "nearest" });
          const first = choices.querySelector("input, button");
          if (first && keep > 0) first.focus({ preventScroll: true });
        };
        if (!rest.length || reduce || fast) {
          rest.forEach((m, i) => thread.append(rowEl(m, msgs[keep + i - 1], false)));
          shown = msgs.length;
          done();
          return;
        }
        let i = 0;
        const next = () => {
          if (my !== token) return;
          const m = rest[i], idx = keep + i;
          if (m.from === "bot") {
            const t = document.createElement("li");
            t.className = "row bot" + (msgs[idx - 1]?.from === "bot" ? "" : " first");
            t.innerHTML = `<span class="face" aria-hidden="true">선배</span><div class="col"><span class="name">길잡이 선배</span><div class="b" aria-label="입력 중"><span class="typing"><i></i><i></i><i></i></span></div></div>`;
            thread.append(t);
            t.scrollIntoView({ block: "nearest" });
            setTimeout(() => {
              if (my !== token) return;
              t.replaceWith(rowEl(m, msgs[idx - 1], true));
              step();
            }, i === 0 ? 320 : 220);
          } else {
            thread.append(rowEl(m, msgs[idx - 1], true));
            step();
          }
        };
        const step = () => {
          i++; shown = keep + i;
          thread.lastElementChild?.scrollIntoView({ block: "nearest" });
          if (i < rest.length) next(); else done();
        };
        next();
      }

      function restart() {
        S = { a: blank(), done: false, undo: null, resume: null };
        worryText = "";
        forget();
        leaveResult();
        shown = 1;
        update();
        scrollTo({ top: 0 });
      }

      backBtn.addEventListener("click", () => {
        const qi = nextQ();
        if (qi <= 0) return;
        S.a = S.a.map((x, i) => (i === qi - 1 ? null : x));
        S.undo = null;
        save();
        shown = messages().length;
        update();
      });
      skipBtn.addEventListener("click", () => { const qi = nextQ(); if (qi >= 0) answer(qi, "skip"); });
      restartBtn.addEventListener("click", restart);

      // ---------- result ----------
      function leaveResult() {
        S.done = false;
        document.body.classList.remove("done");
        result.hidden = true;
      }

      function totals() {
        const T = Object.fromEntries(H.map((h) => [h, 0]));
        QUIZ.forEach((i) => { const v = S.a[i]; if (v && v !== "skip") for (const [h, n] of Object.entries(ST[i].score[v] || {})) T[h] += n; });
        return T;
      }

      // Ranking (D14: a starting point, not a diagnosis).
      //   t[h]     = T[h] / M[h]  the answers' total for type h over the most that type can get (quiz max), so 0..1
      //   score(f) = Σ w_k · t[h_k] / Σ w_k  over the field's holland codes h_1..h_3, with w = 3, 2, 1
      // so the first code weighs most and a one-code field is not punished for having fewer codes.
      // Ties: fields with a 노선도 first, then catalog order. With no scored answer at all every score is 0.
      const W = [3, 2, 1];
      function rank(T) {
        const t = Object.fromEntries(H.map((h) => [h, D.max[h] ? T[h] / D.max[h] : 0]));
        return D.cat.map((f, i) => {
          const ws = f.holland.map((_, k) => W[k]);
          const score = f.holland.reduce((s, h, k) => s + W[k] * t[h], 0) / ws.reduce((a, b) => a + b, 0);
          return { f, i, score };
        }).sort((a, b) => b.score - a.score || Number(b.f.ready) - Number(a.f.ready) || a.i - b.i);
      }
      // Which answers pointed to a field: each quiz answer's Σ w_k · score[h_k], the two largest above zero.
      // On a tie, an answer not yet quoted for a field above wins, so three fields do not repeat the same two lines.
      function because(f, used) {
        return QUIZ.map((i) => {
          const v = S.a[i];
          if (!v || v === "skip") return null;
          const sc = ST[i].score[v] || {};
          const c = f.holland.reduce((s, h, k) => s + W[k] * (sc[h] || 0), 0);
          return c > 0 ? { i, c, text: plain(label(i, v)) } : null;
        }).filter(Boolean).sort((a, b) => b.c - a.c || Number(used.has(a.i)) - Number(used.has(b.i)) || a.i - b.i).slice(0, 2)
          .map((w) => (used.add(w.i), w));
      }

      const botRow = (inner, first) =>
        `<li class="row bot${first ? " first" : ""}"><span class="face" aria-hidden="true">선배</span><div class="col">${first ? `<span class="name">길잡이 선배</span>` : ""}${inner}</div></li>`;

      function renderRecap(picks, anyScore) {
        const sit = ["age", "school", "region"].map((id) => { const i = SI[id], v = S.a[i]; return v === "skip" ? `${ST[i].key} 건너뜀` : label(i, v); });
        const n = D.cat.length;
        const intro = !anyScore
          ? "관심 질문에 고른 답이 없어서 순서 없이 보여 줄게요. 아무 분야나 한번 들여다봐도 돼요."
          : n === 1
            ? `고른 답으로 찾아봤어요. 아직은 분야가 ${n}개뿐이라 순위를 매기지 않았어요. 분야는 하나씩 늘리는 중이에요.`
            : n < 5
              ? `고른 답과 가까운 쪽부터 놓았어요. 아직 분야가 ${n}개뿐이라 가볍게 봐 주세요.`
              : `고른 답과 가까운 분야 ${picks.length}개예요. 정해 주는 게 아니라, 먼저 들여다볼 곳이에요.`;
        let h = `<ol class="thread recap-thread" aria-label="대화 요약">${botRow(`<div class="b">${esc(intro)}</div>`, true)}</ol>`;
        h += `<div class="answers"><div class="row me"><div class="b"><span class="sr">내 상황: </span>${esc(sit.join(" · "))}</div></div>`;
        if (worryText) {
          h += `<div class="row me"><div class="b worry"><span class="w-k">적어 준 고민</span>${esc(worryText)}</div></div>` +
            `<p class="w-note">이 고민은 저장하지도 보내지도 않았어요. 이 화면을 닫으면 사라져요.</p>`;
        }
        h += `</div>`;
        $("recap").innerHTML = h;
      }

      function renderPicks(picks, anyScore) {
        const used = new Set();
        $("picks").innerHTML = picks.map(({ f }, k) => {
          const why = anyScore ? because(f, used) : [];
          const reason = why.length
            ? `<p class="pk-why"><span>고른 답</span>${why.map((w) => `‘${esc(w.text)}’`).join(", ")}</p>`
            : anyScore ? `<p class="pk-why"><span>고른 답</span>딱 겹치는 답은 없었어요. 그래도 한번 볼 만해요.</p>` : "";
          const act = f.ready
            ? `<a class="pk-go" href="${esc(f.href)}"><span>${esc(f.title)} 노선도 보기</span><i aria-hidden="true">→</i></a>`
            : `<p class="pk-soon"><b>노선도 준비 중</b>${f.tryFirst ? `<span>먼저 이것부터: ${esc(f.tryFirst)}</span>` : ""}</p>`;
          const jobs = f.jobs.length ? `<p class="pk-jobs">${f.jobs.map(esc).join(" · ")}</p>` : "";
          return `<li class="pk" style="--c:${["var(--line-1)", "var(--line-2)", "var(--line-3)"][k]}">` +
            `<span class="pk-dot" aria-hidden="true">${k + 1}</span>` +
            `<div class="pk-body"><h2 class="pk-title display">${esc(f.title)}</h2>${jobs}<p class="pk-line">${esc(f.oneLine)}</p>${reason}${act}</div></li>`;
        }).join("");
        const n = D.cat.length;
        $("start-note").textContent = n < 3
          ? `지금 찾기 대화가 보여 줄 수 있는 분야는 ${n}개예요. 분야가 늘어나면 결과도 달라져요.`
          : "";
        $("start-note").hidden = n >= 3;
      }

      // 내 조건 혜택: region = mine or 전국 (skipped = 전국 only), age ranges overlap when both are known,
      // 학교 밖 전용 only for 학교 밖, 고등학생·대학생 대상 장학금 hidden for 학교 밖. Related to a shown field first
      // (its benefit_words in the title or summary), then the soonest deadline, 상시 after the dated ones.
      function renderMine(picks) {
        const age = ans("age"), school = ans("school"), region = ans("region");
        const relOf = (x) => picks.find(({ f }) => x.fi?.includes(f.id) || f.words.some((w) => x.q.includes(w.toLowerCase())))?.f.title || "";
        const list = board.filter((x) => {
          if (region && region !== "skip" ? !(x.r.includes("all") || x.r.includes(region)) : !x.r.includes("all")) return false;
          if (age && age !== "skip") {
            const [lo, hi] = AGE[age];
            if ((x.lo ?? 0) > hi || (x.hi ?? 200) < lo) return false;
          }
          if (x.oos && school !== "left") return false;
          if (x.stu && school === "left") return false;
          return true;
        }).map((x) => ({ ...x, rel: relOf(x) }));
        list.sort((a, b) => Number(!!b.rel) - Number(!!a.rel) || (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
        const top = list.slice(0, 6);

        const bits = [
          age && age !== "skip" ? label(SI.age, age) : "",
          school === "left" ? "학교 밖" : school === "in" ? "학교 다님" : school === "done" ? "졸업" : "",
          region && region !== "skip" ? `${D.regions[region]} + 전국` : "전국 대상만",
        ].filter(Boolean);
        $("mine-scope").textContent = bits.join(" · ");
        $("mine-count").innerHTML = list.length ? `맞는 혜택 <b>${list.length}개</b> 중 ${list.length > 6 ? "마감 가까운 6개" : "전부"}` : "";
        $("mine-empty").hidden = list.length > 0;
        $("mrows").innerHTML = top.map((x) => {
          const always = x.st === "always";
          const n = always ? 0 : days(today, x.date);
          const todayEnd = x.st === "open" && n === 0;
          const dd = always ? "상시" : todayEnd ? "오늘 마감" : `D-${n}`;
          const sub = always ? "언제든" : todayEnd ? "" : x.st === "open" ? "마감" : "접수 시작";
          const when = x.win ? (x.win[0] === x.win[1] ? md(x.win[0]) : `${md(x.win[0])}~${md(x.win[1])}`) : "상시 신청";
          const urgent = x.st === "open" && n <= 7;
          const hint = school === "left" && (x.ok || x.oos) ? `<span class="m-hint">학교 밖 청소년도 신청할 수 있다고 적혀 있어요</span>` : "";
          return `<li><a class="mr" href="${D.helps}${esc(x.i)}/" style="--c:${D.colors[x.k]}">` +
            `<span class="m-top"><span class="m-kind"><i aria-hidden="true"></i>${esc(D.kinds[x.k])}</span><span class="m-reg">${esc(x.rl)}</span></span>` +
            (x.rel ? `<span class="m-rel">이 분야 관련 · ${esc(x.rel)}</span>` : "") +
            `<span class="m-title">${esc(x.t)}</span><span class="m-prov">${esc(x.p)} · 신청 ${esc(when)}</span>${hint}` +
            `<span class="m-dd s-${x.st}${urgent ? " urgent" : ""}${todayEnd ? " today" : ""}"><b>${dd}</b>${sub ? `<small>${sub}</small>` : ""}</span></a></li>`;
        }).join("");
        const qs = new URLSearchParams();
        qs.set("region", region && region !== "skip" ? region : "all");
        $("mine-all").href = `${D.helps}?${qs}`;
      }

      function renderTools() {
        const a = S.a;
        $("res-tools").innerHTML =
          `<details class="edit"><summary>답 바꾸기</summary><ul>` +
          a.map((v, i) => (ST[i].kind === "worry" ? "" :
            `<li><button type="button" data-edit="${i}"><span>${esc(ST[i].kind === "quiz" ? `관심 ${QUIZ.indexOf(i) + 1}` : ST[i].key)}</span><b>${esc(v === "skip" ? "건너뜀" : plain(label(i, v)))}</b><em>바꾸기</em></button></li>`)).join("") +
          `</ul></details><button type="button" class="tool" data-act="restart">처음부터 다시</button>`;
      }

      function enterResult(fresh) {
        S.done = true;
        const T = totals();
        const anyScore = H.some((h) => T[h] > 0);
        const picks = rank(T).slice(0, 3);
        $("result-title").textContent = D.cat.length === 1 ? "지금 볼 수 있는 분야" : "해 볼 만한 분야";
        renderRecap(picks, anyScore);
        renderPicks(picks, anyScore);
        renderMine(picks);
        renderTools();
        document.body.classList.add("done");
        result.hidden = false;
        if (fresh) count("find-talk/done");
        scrollTo({ top: 0 });
        $("result-title").focus({ preventScroll: true });
      }

      function editAnswer(i) {
        S.undo = { i, v: S.a[i] };
        S.a = S.a.map((x, j) => (j === i ? null : x));
        leaveResult();
        shown = messages().length;
        update();
        requestAnimationFrame(() => composer.scrollIntoView({ block: "end" }));
      }

      result.addEventListener("click", (e) => {
        const ed = e.target.closest("[data-edit]");
        if (ed) return editAnswer(+ed.dataset.edit);
        const act = e.target.closest("[data-act]");
        if (act && act.dataset.act === "restart") restart();
      });

      // ---------- start: finished before = straight to the result; halfway = ask to continue ----------
      const saved = load();
      if (saved && saved.every((v) => v != null)) {
        S.a = saved;
        shown = messages().length;
        update();
        token++; // drop the delayed enterResult that update() queued
        enterResult(false);
      } else if (saved && saved.some((v) => v != null)) {
        // A reload would restore the old scroll position and hide the opening behind the question.
        if ("scrollRestoration" in history) history.scrollRestoration = "manual";
        scrollTo({ top: 0 });
        S.resume = saved;
        update();
      } else update();
    })();
  </script>
</Site>

<style is:global>
  /* Home = find-talk. The conversation bones match the field page (fields/[field].astro); scoped under .ft. */
  .ft { max-width: 1160px; margin: 0 auto; padding: 0 16px; }
  .ft .eyebrow { margin: 0 0 6px; font-size: 15px; font-weight: 600; color: var(--ink-2); }
  .ft h1 { margin: 0; font-size: clamp(38px, 10.5vw, 60px); line-height: 1.08; }
  .ft .opening { padding: 26px 0 6px; }
  .ft .lead { margin: 12px 0 0; font-size: 17px; line-height: 1.6; max-width: 26em; }
  .ft .nojs-note { margin: 12px 0 0; padding: 8px 10px; background: var(--mark); font-size: 15px; max-width: 30em; }
  .js .ft .nojs-note { display: none; }
  body.done .ft-stage { display: none; }

  /* ---------- conversation ---------- */
  .ft .talk { display: flex; flex-direction: column; margin: 8px -16px 0; min-height: calc(100dvh - 52px - 40px); }
  html:not(.js) .ft .talk { display: none; }
  .ft .thread { list-style: none; margin: 0; padding: 8px 16px 8px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .ft .talk .thread > li { scroll-margin-bottom: var(--ch, 300px); scroll-margin-top: 60px; }
  .ft .row { display: flex; gap: 8px; align-items: flex-start; max-width: 100%; }
  .ft .row.me { justify-content: flex-end; margin: 6px 0; }
  .ft .row.bot.first { margin-top: 8px; }
  .ft .face {
    flex: none; width: 38px; height: 38px; border-radius: 14px; background: var(--me); color: var(--me-ink);
    display: grid; place-items: center; font: 600 12px var(--ui);
  }
  .ft .row.bot:not(.first) .face { visibility: hidden; }
  .ft .col { display: flex; flex-direction: column; gap: 4px; min-width: 0; max-width: calc(100% - 46px); }
  .ft .col > .name { font-size: 13px; color: var(--ink-2); }
  .ft .row.bot:not(.first) .col > .name { display: none; }
  .ft .b {
    font: 17px/1.55 var(--bubble); padding: 10px 14px; border-radius: 4px 18px 18px 18px;
    background: var(--bubble-bg); box-shadow: 0 1px 0 rgba(27, 31, 42, .08);
  }
  .ft .row.bot:not(.first) .b { border-radius: 18px; }
  .ft .row.me .b { background: var(--me); color: var(--me-ink); border-radius: 18px 4px 18px 18px; max-width: 85%; }
  .ft .row.me .b.worry { background: var(--mark); color: var(--ink); }
  .ft .b .sub { display: block; font: 14px/1.5 var(--ui); color: var(--ink-2); margin-top: 2px; }
  .ft .typing { display: inline-flex; gap: 4px; padding: 14px; }
  .ft .typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--ink-2); opacity: .4; animation: ft-blink 1s infinite; }
  .ft .typing i:nth-child(2) { animation-delay: .15s; } .ft .typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes ft-blink { 50% { opacity: 1; } }
  .ft .row.new { animation: ft-rise .22s ease-out; }
  @keyframes ft-rise { from { opacity: 0; transform: translateY(6px); } }

  .ft .composer {
    position: sticky; bottom: 0; z-index: 5; background: var(--bubble-bg); border-top: 2px solid var(--ink);
    padding: 10px 16px calc(12px + env(safe-area-inset-bottom));
  }
  .ft .prog { display: flex; align-items: center; gap: 10px; margin: 0 0 4px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .ft .prog-t { flex: none; min-width: 5.5em; font-variant-numeric: tabular-nums; }
  .ft .track { flex: 1; height: 6px; border-radius: 3px; background: var(--rule); overflow: hidden; }
  .ft .track i { display: block; height: 100%; width: 0; background: var(--line-1); border-radius: 3px; transition: width .25s; }
  .ft .composer .q { margin: 0 0 8px; font-size: 14px; color: var(--ink-2); }
  .ft .choices { display: grid; gap: 8px; }
  .ft .choices.two { grid-template-columns: 1fr 1fr; }
  .ft .choices.three { grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .ft .choices.three .choice { min-height: 44px; padding: 8px 10px; text-align: center; }
  .ft .choice {
    min-height: 48px; padding: 10px 14px; border-radius: 14px; border: 1.5px solid var(--me);
    background: var(--bubble-bg); color: var(--me); text-align: left; font: 500 16px/1.35 var(--ui); cursor: pointer;
  }
  .ft .choice:hover { background: #eaf2ee; }
  .ft .choice.ghost { border-style: dashed; border-color: var(--lead); color: var(--ink-2); grid-column: 1 / -1; text-align: center; }
  .ft .choices.worry { grid-template-columns: 1fr; }
  .ft #worry-in {
    width: 100%; min-height: 48px; padding: 0 14px; border: 1.5px solid var(--ink); border-radius: 14px; background: #fff;
    font: 17px var(--bubble); color: var(--ink);
  }
  .ft #worry-in::placeholder { color: var(--ink-2); font-size: 15px; }
  .ft .tools { display: flex; justify-content: space-between; gap: 4px 8px; margin-top: 6px; flex-wrap: wrap; }
  .ft .tool {
    min-height: 44px; padding: 0 6px; border: 0; background: none; color: var(--ink-2);
    font: 15px var(--ui); text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
  }
  .ft .privacy { margin: 2px 0 0; font-size: 13px; color: var(--ink-2); }

  /* ---------- side: the way in without the talk (and the whole page without JS) ---------- */
  .ft .side { margin-top: 36px; }
  .ft .side h2 { margin: 0 0 10px; font-size: 22px; }
  .ft .go {
    display: flex; align-items: stretch; text-decoration: none; background: #fff;
    border: 2px solid var(--ink); border-bottom: 8px solid var(--line-1); min-height: 64px;
  }
  .ft .go-t { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 8px 14px; min-width: 0; }
  .ft .go-t small { font-size: 14px; color: var(--ink-2); }
  .ft .go-t b { font: 400 22px/1.25 var(--display); }
  .ft .go-arrow { display: grid; place-items: center; width: 60px; background: var(--ink); color: #fff; font-size: 24px; font-weight: 700; }
  .ft .go:hover .go-t b { text-decoration: underline; text-decoration-color: var(--line-1); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .ft .now {
    display: flex; flex-direction: column; margin-top: 16px; padding: 8px 0 8px 14px; min-height: 44px;
    border-left: 6px solid var(--carrot); text-decoration: none;
  }
  .ft .now span { font-weight: 700; font-size: 17px; }
  .ft .now span::after { content: " →"; }
  .ft .now b { color: var(--carrot); }
  .ft .now small { font-size: 14px; color: var(--ink-2); }
  .ft .now:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .ft .cat { margin-top: 22px; }
  .ft .cat h3 { margin: 0 0 6px; font-size: 15px; font-weight: 700; color: var(--ink-2); }
